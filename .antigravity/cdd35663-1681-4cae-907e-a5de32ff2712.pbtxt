    content: "                  title=\"Elimina abitazione\"\n                >\n                  <Trash2 className=\"w-3.5 h-3.5\" />\n                </button>\n              )}\n            </div>\n          ))}\n        </div>\n\n        {/* Add custom house location */}\n        <form onSubmit={handleAddLocation} className=\"pt-2 border-t border-app-subtle flex gap-2 text-xs\">\n          <select\n            value={newLocationIcon}\n            onChange={(e) => setNewLocationIcon(e.target.value)}\n            className=\"px-2 py-1.5 rounded-lg border border-app-subtle bg-app-card text-app-main outline-hidden\"\n          >\n            <option value=\"\360\237\217\240\">\360\237\217\240 Casa</option>\n            <option value=\"\360\237\217\241\">\360\237\217\241 Villa</option>\n            <option value=\"\360\237\217\224\357\270\217\">\360\237\217\224\357\270\217 Montagna</option>\n            <option value=\"\360\237\217\226\357\270\217\">\360\237\217\226\357\270\217 Mare</option>\n            <option value=\"\360\237\217\225\357\270\217\">\360\237\217\225\357\270\217 Rustico</option>\n          </select>\n          <input\n            type=\"text\"\n            placeholder=\"Aggiungi altra casa (es. Casa Vacanze)...\"\n            value={newLocationName}\n            onChange={(e) => setNewLocationName(e.target.value)}\n            className=\"flex-1 px-3 py-1.5 rounded-lg border border-app-subtle bg-app-card text-app-main outline-hidden\"\n          />\n          <button\n            type=\"submit\"\n            disabled={!newLocationName.trim()}\n            className=\"px-3 py-1.5 bg-app-primary text-white font-bold rounded-lg shadow-xs disabled:opacity-40 cursor-pointer\"\n          >\n            Aggiungi\n          </button>\n        </form>\n      </section>\n\n      {/* 3. Profilo Utente & Nomi */}\n      <section className=\"bg-app-card rounded-2xl border border-app-subtle p-4 sm:p-6 shadow-xs space-y-4\">\n        <div className=\"flex items-center gap-2.5 border-b border-app-subtle pb-3\">\n          <div className=\"w-8 h-8 rounded-xl bg-app-primary-light text-app-primary flex items-center justify-center font-bold\">\n            <UserCheck className=\"w-4 h-4\" />\n          </div>\n          <div>\n            <h2 className=\"font-bold text-base text-app-main tracking-tight\">\n              Profilo Utente su questo Smartphone\n            </h2>\n            <p className=\"text-xs text-app-muted\">\n              Identit\303\240 per i pasti separati e per la spunta dei prodotti\n            </p>\n          </div>\n        </div>\n\n        {/* Current Active User Selection */}\n        <div>\n          <label className=\"text-xs font-bold text-app-main block mb-2\">\n            Questo smartphone appartiene a:\n          </label>\n          <div className=\"grid grid-cols-2 gap-3\">\n            <button\n              type=\"button\"\n              onClick={() => setCurrentRole(\'daniele\')}\n              className={`p-3 rounded-xl border text-left transition-all cursor-pointer flex items-center gap-3 ${\n                currentRole === \'daniele\'\n                  ? \'border-app-primary bg-app-primary-light shadow-xs\'\n                  : \'border-app-subtle bg-app-card hover:bg-app-muted\'\n              }`}\n            >\n              <span className=\"text-2xl\">{household.users.daniele.avatar}</span>\n              <div>\n                <span className=\"font-bold text-xs text-app-main block\">\n                  {household.users.daniele.name}\n                </span>\n                <span className=\"text-[10px] text-app-muted\">\n                  {currentRole === \'daniele\' ? \'Attivo su questo telefono\' : \'Clicca per attivare\'}\n                </span>\n              </div>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => setCurrentRole(\'partner\')}\n              className={`p-3 rounded-xl border text-left transition-all cursor-pointer flex items-center gap-3 ${\n                currentRole === \'partner\'\n                  ? \'border-app-primary bg-app-primary-light shadow-xs\'\n                  : \'border-app-subtle bg-app-card hover:bg-app-muted\'\n              }`}\n            >\n              <span className=\"text-2xl\">{household.users.partner.avatar}</span>\n              <div>\n                <span className=\"font-bold text-xs text-app-main block\">\n                  {household.users.partner.name}\n                </span>\n                <span className=\"text-[10px] text-app-muted\">\n                  {currentRole === \'partner\' ? \'Attivo su questo telefono\' : \'Clicca per attivare\'}\n                </span>\n              </div>\n            </button>\n          </div>"
