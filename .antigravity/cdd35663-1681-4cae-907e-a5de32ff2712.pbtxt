    use_fast_apply: true
    replacement_infos {
      original_chunk {
        target_content: "interface MealSlotCardProps {\n  title: string;\n  mealType: MealType;\n  slot: MealSlot;\n  dayKey: DayKey;\n  onToggleType: () => void;\n  onOpenAdd: (target: \'together\' | \'daniele\' | \'partner\') => void;\n  onRemoveDish: (target: \'together\' | \'daniele\' | \'partner\', dishId: string) => void;\n  currentRole: \'daniele\' | \'partner\';\n}\n\nconst MealSlotCard: React.FC<MealSlotCardProps> = ({\n  title,\n  slot,\n  onToggleType,\n  onOpenAdd,\n  onRemoveDish,\n}) => {\n  const { household } = useHousehold();\n  const isTogether = slot.type === \'together\';\n\n  return (\n    <div className=\"rounded-xl border border-app-subtle bg-app-card p-3 flex flex-col justify-between\">\n      {/* Slot Header */}\n      <div className=\"flex items-center justify-between mb-2.5\">\n        <div className=\"flex items-center gap-1.5\">\n          <span className=\"text-xs font-bold text-app-main tracking-tight uppercase\">\n            {title}\n          </span>\n          <span className=\"text-[10px] text-app-muted\">\302\267</span>\n          <span className=\"text-[11px] font-medium text-app-muted\">\n            {isTogether ? \'Pasto Insieme\' : \'Pasti Separati\'}\n          </span>\n        </div>"
        replacement_content: "interface MealSlotCardProps {\n  title: string;\n  mealType: MealType;\n  slot: MealSlot;\n  dayKey: DayKey;\n  activeWeekId: string;\n  onToggleType: () => void;\n  onOpenAdd: (target: \'together\' | \'daniele\' | \'partner\') => void;\n  onRemoveDish: (target: \'together\' | \'daniele\' | \'partner\', dishId: string) => void;\n  currentRole: \'daniele\' | \'partner\';\n}\n\nconst MealSlotCard: React.FC<MealSlotCardProps> = ({\n  title,\n  slot,\n  dayKey,\n  activeWeekId,\n  onToggleType,\n  onOpenAdd,\n  onRemoveDish,\n}) => {\n  const { household, setMealLocation } = useHousehold();\n  const isTogether = slot.type === \'together\';\n\n  const houses = household.houses || [\n    { id: \'casa_daniele\', name: \'Casa Daniele\', icon: \'\360\237\217\240\' },\n    { id: \'casa_partner\', name: \'Casa Partner\', icon: \'\360\237\217\241\' },\n  ];\n\n  return (\n    <div className=\"rounded-xl border border-app-subtle bg-app-card p-3 flex flex-col justify-between\">\n      {/* Slot Header */}\n      <div className=\"flex items-center justify-between mb-2.5\">\n        <div className=\"flex items-center gap-1.5 flex-wrap\">\n          <span className=\"text-xs font-bold text-app-main tracking-tight uppercase\">\n            {title}\n          </span>\n          <span className=\"text-[10px] text-app-muted\">\302\267</span>\n          {isTogether ? (\n            <select\n              value={slot.location || \'casa_daniele\'}\n              onChange={(e) => setMealLocation(activeWeekId, dayKey, mealType, e.target.value)}\n              className=\"text-[11px] font-semibold text-app-primary bg-app-muted/60 px-1.5 py-0.5 rounded-md border-0 cursor-pointer outline-hidden hover:bg-app-primary-light\"\n              title=\"Seleziona in quale casa mangiate insieme\"\n            >\n              {houses.map((h) => (\n                <option key={h.id} value={h.id}>\n                  {h.icon} {h.name}\n                </option>\n              ))}\n              <option value=\"fuori\">\360\237\215\275\357\270\217 Fuori</option>\n            </select>\n          ) : (\n            <span className=\"text-[11px] font-medium text-amber-700 dark:text-amber-300\">\n              Pasti Separati\n            </span>\n          )}\n        </div>"
        start_line: 308
        end_line: 342
      }
      use_global_match: true
    }
    description: "Add location selector to meal slots in WeeklyMenuView"
    diff_stats {
      additions: 29
      deletions: 5
    }
  }
}
