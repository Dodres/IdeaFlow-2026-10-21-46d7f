    content: "                <span>Tutti Insieme ({members.length})</span>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={handleSetAllSeparate}\n                className=\"py-2 px-3 rounded-xl border border-app-subtle hover:border-app-primary hover:bg-app-primary-light/50 transition-colors text-app-main font-semibold flex items-center justify-center gap-1.5 cursor-pointer\"\n              >\n                <User className=\"w-4 h-4 text-amber-600\" />\n                <span>Tutti Separati (1 a 1)</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Groups Customizer */}\n          <div className=\"space-y-3 pt-2 border-t border-app-subtle\">\n            <div className=\"flex items-center justify-between\">\n              <span className=\"text-[11px] font-bold uppercase tracking-wider text-app-muted\">\n                Gruppi a Tavola ({groups.length}):\n              </span>\n              <button\n                type=\"button\"\n                onClick={handleAddNewGroup}\n                className=\"text-[11px] font-semibold text-app-primary hover:bg-app-primary-light px-2 py-1 rounded-lg flex items-center gap-1 cursor-pointer\"\n              >\n                <Plus className=\"w-3.5 h-3.5\" /> Aggiungi Gruppo\n              </button>\n            </div>\n\n            <div className=\"space-y-3\">\n              {groups.map((group, gIdx) => {\n                const groupMembers = group.memberIds\n                  .map((id) => memberMap.get(id))\n                  .filter(Boolean) as Person[];\n\n                const isSingle = groupMembers.length === 1;\n\n                return (\n                  <div\n                    key={group.id}\n                    className=\"p-3 rounded-xl border border-app-subtle bg-app-muted/30 space-y-2.5\"\n                  >\n                    <div className=\"flex items-center justify-between\">\n                      <span className=\"font-bold text-xs text-app-main flex items-center gap-1.5\">\n                        <span className=\"w-5 h-5 rounded-full bg-app-card border border-app-subtle flex items-center justify-center text-[10px] text-app-primary font-bold\">\n                          {gIdx + 1}\n                        </span>\n                        {isSingle\n                          ? `Mangia da solo/a: ${groupMembers[0]?.name || \'\'}`\n                          : `Mangiano insieme (${groupMembers.length} persone)`}\n                      </span>\n\n                      {groups.length > 1 && (\n                        <button\n                          type=\"button\"\n                          onClick={() => handleRemoveGroup(group.id)}\n                          className=\"text-app-muted hover:text-rose-500 p-1 rounded-md cursor-pointer\"\n                          title=\"Elimina gruppo\"\n                        >\n                          <Trash2 className=\"w-3.5 h-3.5\" />\n                        </button>\n                      )}\n                    </div>\n\n                    {/* Member chips inside this group */}\n                    <div className=\"flex flex-wrap gap-1.5 min-h-[32px] p-1.5 rounded-lg bg-app-card border border-app-subtle/60\">\n                      {groupMembers.length === 0 ? (\n                        <span className=\"text-[11px] text-app-muted italic p-1\">\n                          Trascina o tocca un membro qui sotto per aggiungerlo a questo gruppo\n                        </span>\n                      ) : (\n                        groupMembers.map((m) => (\n                          <div\n                            key={m.id}\n                            className=\"px-2.5 py-1 rounded-lg bg-app-primary-light text-app-primary border border-app-primary-border flex items-center gap-1.5 text-xs font-semibold\"\n                          >\n                            <span>{m.avatar}</span>\n                            <span>{m.name}</span>\n                          </div>\n                        ))\n                      )}\n                    </div>\n\n                    {/* Quick Move Buttons */}\n                    {groups.length > 1 && (\n                      <div className=\"flex flex-wrap items-center gap-1 text-[11px] pt-1\">\n                        <span className=\"text-app-muted text-[10px] mr-1\">Sposta qui:</span>\n                        {members\n                          .filter((m) => !group.memberIds.includes(m.id))\n                          .map((m) => (\n                            <button\n                              key={m.id}\n                              type=\"button\"\n                              onClick={() => handleMoveMember(m.id, group.id)}\n                              className=\"px-2 py-0.5 rounded-md bg-app-card hover:bg-app-muted border border-app-subtle text-app-main font-medium cursor-pointer\"\n                            >\n                              + {m.avatar} {m.name}\n                            </button>\n                          ))}\n                      </div>\n                    )}\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n        </div>\n\n        {/* Footer */}\n        <div className=\"p-3 bg-app-muted/30 border-t border-app-subtle flex items-center justify-end gap-2 text-xs\">\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"px-4 py-2 font-semibold text-app-muted hover:bg-app-muted rounded-xl cursor-pointer\"\n          >\n            Annulla\n          </button>\n          <button\n            type=\"button\"\n            onClick={handleSave}\n            className=\"px-5 py-2 font-bold bg-app-primary text-white rounded-xl hover:opacity-90 transition-opacity shadow-xs cursor-pointer flex items-center gap-1.5\"\n          >\n            <Check className=\"w-4 h-4\" />\n            <span>Conferma Gruppi</span>\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
