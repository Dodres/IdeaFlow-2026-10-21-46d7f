    content: "  const registerSavedHousehold = (code: string, name: string) => {\n    setSavedHouseholds((prev) => {\n      const filtered = prev.filter((h) => h.code !== code);\n      const updated = [{ code, name }, ...filtered];\n      localStorage.setItem(SAVED_HOUSES_KEY, JSON.stringify(updated));\n      return updated;\n    });\n  };\n\n  const removeSavedHousehold = (code: string) => {\n    setSavedHouseholds((prev) => {\n      const updated = prev.filter((h) => h.code !== code);\n      localStorage.setItem(SAVED_HOUSES_KEY, JSON.stringify(updated));\n      return updated;\n    });\n  };\n\n  // Fetch initial household data\n  const fetchHousehold = useCallback(async (code: string) => {\n    try {\n      setIsLoading(true);\n      const res = await fetch(`/api/households/${code}`);\n      if (res.ok) {\n        const data = await res.json();\n        if (!data.houses || data.houses.length === 0) {\n          data.houses = [\n            { id: \'casa_daniele\', name: \'Casa Daniele\', icon: \'\360\237\217\240\' },\n            { id: \'casa_partner\', name: \'Casa Partner\', icon: \'\360\237\217\241\' },\n          ];\n        }\n        if (!data.members || data.members.length === 0) {\n          if (data.users) {\n            data.members = [\n              { id: \'daniele\', name: data.users.daniele?.name || \'Daniele\', avatar: data.users.daniele?.avatar || \'\360\237\221\250\342\200\215\360\237\215\263\' },\n              { id: \'partner\', name: data.users.partner?.name || \'Partner\', avatar: data.users.partner?.avatar || \'\360\237\221\251\342\200\215\360\237\214\276\' },\n            ];\n          } else {\n            data.members = [{ id: \'daniele\', name: \'Daniele\', avatar: \'\360\237\221\250\342\200\215\360\237\215\263\' }];\n          }\n        }\n        setHousehold(data);\n        registerSavedHousehold(data.code, data.name || data.code);\n      } else if (res.status === 404) {\n        console.warn(`Household ${code} not found, initializing...`);\n      }\n    } catch (err) {\n      console.error(\'Fetch household error:\', err);\n    } finally {\n      setIsLoading(false);\n    }\n  }, []);\n\n  useEffect(() => {\n    fetchHousehold(householdCode);\n  }, [householdCode, fetchHousehold]);\n\n  // Real-time SSE connection\n  useEffect(() => {\n    let eventSource: EventSource | null = null;\n    let reconnectTimeout: any = null;\n\n    const connectSSE = () => {\n      try {\n        eventSource = new EventSource(`/api/households/${householdCode}/events`);\n\n        eventSource.onopen = () => {\n          setIsConnected(true);\n        };\n\n        eventSource.addEventListener(\'update\', (e: MessageEvent) => {\n          try {\n            const payload = JSON.parse(e.data);\n            if (payload && payload.household) {\n              setHousehold(payload.household);\n              registerSavedHousehold(payload.household.code, payload.household.name);\n            }\n          } catch (err) {\n            console.error(\'SSE JSON error:\', err);\n          }\n        });\n\n        eventSource.onerror = () => {\n          setIsConnected(false);\n          eventSource?.close();\n          reconnectTimeout = setTimeout(connectSSE, 3000);\n        };\n      } catch (err) {\n        setIsConnected(false);\n      }\n    };\n\n    connectSSE();\n\n    return () => {\n      if (eventSource) eventSource.close();\n      if (reconnectTimeout) clearTimeout(reconnectTimeout);\n    };\n  }, [householdCode]);\n\n  const saveHouseholdState = async (updated: Household) => {\n    setHousehold(updated);\n    setIsSyncing(true);\n    try {\n      await fetch(`/api/households/${householdCode}`, {\n        method: \'PUT\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify(updated),\n      });\n      registerSavedHousehold(updated.code, updated.name);\n    } catch (err) {\n      console.error(\'Failed to sync household:\', err);\n    } finally {\n      setIsSyncing(false);\n    }\n  };\n\n  const updateHousehold = async (updater: (prev: Household) => Household) => {\n    const next = updater(household);\n    await saveHouseholdState(next);\n  };\n\n  // Switch between saved households in 1 click\n  const switchHousehold = async (code: string): Promise<boolean> => {\n    const upper = code.trim().toUpperCase();\n    try {\n      setIsLoading(true);\n      const res = await fetch(`/api/households/${upper}`);\n      if (res.ok) {\n        const data = await res.json();\n        setHousehold(data);\n        setHouseholdCode(upper);\n        registerSavedHousehold(data.code, data.name);\n        return true;\n      }\n      return false;\n    } catch (err) {\n      return false;\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const joinHousehold = async (code: string): Promise<boolean> => {\n    return switchHousehold(code);\n  };\n\n  const createNewHousehold = async (\n    name: string,\n    customCode?: string,\n    danieleName?: string,\n    partnerName?: string\n  ): Promise<string> => {\n    try {\n      setIsLoading(true);\n      const res = await fetch(\'/api/households\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ name, customCode, danieleName, partnerName }),\n      });\n      if (res.ok) {\n        const data = await res.json();\n        setHousehold(data);\n        setHouseholdCode(data.code);\n        registerSavedHousehold(data.code, data.name);\n        return data.code;\n      }\n      throw new Error(\'Errore creazione spazio\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  // Manage dynamic members (1, 2, 3+ people)\n  const addMember = async (name: string, avatar = \'\360\237\221\244\') => {\n    const newPerson: Person = {\n      id: `usr_${Date.now()}_${Math.random().toString(36).substring(2, 5)}`,\n      name: name.trim(),\n      avatar,\n    };\n    await updateHousehold((prev) => ({\n      ...prev,"
