    content: "export type Season = \'spring\' | \'summer\' | \'autumn\' | \'winter\' | \'all_year\';\n\nexport type DepartmentCategory =\n  | \'ortofrutta\'\n  | \'macelleria_pescheria\'\n  | \'latticini_freschi\'\n  | \'dispensa_secco\'\n  | \'surgelati\'\n  | \'cura_casa_altro\';\n\nexport type Assignee = string; // \'together\' | memberId | group\n\nexport type MealSlotType = \'together\' | \'separate\' | \'custom_groups\';\n\nexport type MealType = \'pranzo\' | \'cena\';\n\nexport type DayKey = \'lun\' | \'mar\' | \'mer\' | \'gio\' | \'ven\' | \'sab\' | \'dom\';\n\nexport interface Person {\n  id: string;\n  name: string;\n  avatar: string;\n}\n\nexport interface Dish {\n  id: string;\n  name: string;\n  recipeId?: string;\n  ingredients?: string[];\n  notes?: string;\n}\n\nexport interface MealGroup {\n  id: string;\n  memberIds: string[]; // List of member IDs in this eating group\n  dishes: Dish[];\n  notes?: string;\n}\n\nexport interface MealSlot {\n  type?: MealSlotType;\n  // Dynamic groups (handles 1 person, 2 people, 3+ people in sub-groups)\n  groups?: MealGroup[];\n  // Legacy fields for backward compatibility\n  togetherDishes?: Dish[];\n  danieleDishes?: Dish[];\n  partnerDishes?: Dish[];\n  location?: \'casa_daniele\' | \'casa_partner\' | \'fuori\' | string;\n  notes?: string;\n}\n\nexport interface DayMeals {\n  dayKey: DayKey;\n  dayLabel: string;\n  pranzo: MealSlot;\n  cena: MealSlot;\n}\n\nexport interface WeekMenu {\n  weekId: string; // e.g. \'2026-W42\'"
