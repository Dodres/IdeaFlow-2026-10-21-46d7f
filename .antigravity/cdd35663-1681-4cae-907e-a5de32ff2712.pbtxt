              text: "export function getCurrentSeason(): Season {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const month = new Date().getMonth(); // 0 = Jan, 9 = Oct"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (month >= 2 && month <= 4) return \'spring\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (month >= 5 && month <= 7) return \'summer\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (month >= 8 && month <= 10) return \'autumn\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return \'winter\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
