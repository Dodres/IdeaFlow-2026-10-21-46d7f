    </div>\n              <div className=\"flex items-center gap-1.5 text-xs text-app-muted\">\n                <span\n                  className={`w-2 h-2 rounded-full ${\n                    isConnected ? \'bg-emerald-500\' : \'bg-amber-500 animate-pulse\'\n                  }`}\n                  title={isConnected ? \'Sincronizzato in tempo reale\' : \'Riconnessione in corso...\'}\n                />\n                <span>{isConnected ? \'Sincronizzato\' : \'Connessione...\'}</span>\n                {isSyncing && (\n                  <RefreshCw className=\"w-3 h-3 animate-spin text-app-primary ml-1\" />\n                )}\n              </div>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            {/* Quick AI button on header */}\n            <button\n              onClick={onOpenAISuggest}\n              className=\"flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-app-primary-light text-app-primary hover:opacity-90 transition-opacity active:scale-95\"\n              title=\"Consigliami ricette di stagione con AI\"\n            >\n              <Sparkles className=\"w-3.5 h-3.5\" />\n              <span className=\"hidden sm:inline\">Ispirazione AI</span>\n            </button>\n\n            {/* Quick Role Switcher */}\n            <button\n              onClick={() => setCurrentRole(otherRole)}\n              className=\"flex items-center gap-2 px-3 py-1.5 rounded-lg border border-app-subtle bg-app-card hover:bg-app-muted transition-colors text-xs font-medium text-app-main cursor-pointer\"\n              title={`Clicca per passare al profilo di ${otherUserName}`}\n            >\n              <span className=\"text-sm\">\n                {currentRole === \'daniele\' ? household.users.daniele.avatar : household.users.partner.avatar}\n              </span>\n              <span className=\"font-semibold\">{currentUserName}</span>\n              <span className=\"text-app-muted text-[10px]\">\342\207\204</span>\n            </button>\n          </div>\n        </div>\n      </header>\n\n      {/* Desktop Navigation Tabs */}\n      <nav className=\"hidden md:block bg-app-card border-b border-app-subtle\">\n        <div className=\"max-w-5xl mx-auto px-4 flex gap-8\">\n          <button\n            onClick={() => setActiveTab(\'menu\')}\n            className={`py-3 text-sm font-semibold border-b-2 transition-colors flex items-center gap-2 ${\n              activeTab === \'menu\'\n                ? \'border-app-primary text-app-primary\'\n                : \'border-transparent text-app-muted hover:text-app-main\'\n            }`}\n          >\n            <Calendar className=\"w-4 h-4\" />\n            <span>Menu Settimanale</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'shopping\')}\n            className={`py-3 text-sm font-semibold border-b-2 transition-colors flex items-center gap-2 ${\n              activeTab === \'shopping\'\n                ? \'border-app-primary text-app-primary\'\n                : \'border-transparent text-app-muted hover:text-app-main\'\n            }`}\n          >\n            <ShoppingCart className=\"w-4 h-4\" />\n            <span>Lista della Spesa</span>\n            {pendingShoppingCount > 0 && (\n              <span className=\"text-xs px-2 py-0.2 rounded-full bg-app-primary text-white font-medium\">\n                {pendingShoppingCount}\n              </span>\n            )}\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'recipes\')}\n            className={`py-3 text-sm font-semibold border-b-2 transition-colors flex items-center gap-2 ${\n              activeTab === \'recipes\'\n                ? \'border-app-primary text-app-primary\'\n                : \'border-transparent text-app-muted hover:text-app-main\'\n            }`}\n          >\n            <BookOpen className=\"w-4 h-4\" />\n            <span>Ricettario & Stagione</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'settings\')}\n            className={`py-3 text-sm font-semibold border-b-2 transition-colors flex items-center gap-2 ${\n              activeTab === \'settings\'\n                ? \'border-app-primary text-app-primary\'\n                : \'border-transparent text-app-muted hover:text-app-main\'\n            }`}\n          >\n            <Settings className=\"w-4 h-4\" />\n            <span>Spazio & Temi</span>\n          </button>\n        </div>\n      </nav>\n\n      {/* Mobile Bottom Navigation Bar */}\n      <nav className=\"md:hidden fixed bottom-0 left-0 right-0 z-40 bg-app-card border-t border-app-subtle pb-safe shadow-lg\">\n        <div className=\"grid grid-cols-4 h-16\">\n          <button\n            onClick={() => setActiveTab(\'menu\')}\n            className={`flex flex-col items-center justify-center gap-1 transition-colors ${\n              activeTab === \'menu\' ? \'text-app-primary\' : \'text-app-muted hover:text-app-main\'\n            }`}\n          >\n            <Calendar className=\"w-5 h-5\" />\n            <span className=\"text-[11px] font-medium\">Menu</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'shopping\')}\n            className={`relative flex flex-col items-center justify-center gap-1 transition-colors ${\n              activeTab === \'shopping\' ? \'text-app-primary\' : \'text-app-muted hover:text-app-main\'\n            }`}\n          >\n            <div className=\"relative\">\n              <ShoppingCart className=\"w-5 h-5\" />\n              {pendingShoppingCount > 0 && (\n                <span className=\"absolute -top-1.5 -right-2 text-[10px] w-4 h-4 rounded-full bg-app-primary text-white flex items-center justify-center font-bold\">\n                  {pendingShoppingCount > 9 ? \'9+\' : pendingShoppingCount}\n                </span>\n              )}\n            </div>\n            <span className=\"text-[11px] font-medium\">Spesa</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'recipes\')}\n            className={`flex flex-col items-center justify-center gap-1 transition-colors ${\n              activeTab === \'recipes\' ? \'text-app-primary\' : \'text-app-muted hover:text-app-main\'\n            }`}\n          >\n            <BookOpen className=\"w-5 h-5\" />\n            <span className=\"text-[11px] font-medium\">Ricette</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'settings\')}\n            className={`flex flex-col items-center justify-center gap-1 transition-colors ${\n              activeTab === \'settings\' ? \'text-app-primary\' : \'text-app-muted hover:text-app-main\'\n            }`}\n          >\n            <Settings className=\"w-5 h-5\" />\n            <span className=\"text-[11px] font-medium\">Spazio</span>\n          </button>\n        </div>\n      </nav>\n    </>\n  );\n};\n"
