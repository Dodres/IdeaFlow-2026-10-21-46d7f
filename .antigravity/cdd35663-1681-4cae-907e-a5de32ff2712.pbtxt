          replacement_content: "    // Households Collection (Collaborative menus & shared lists)\n    match /households/{householdCode} {\n      // Allow reading by direct code lookup (for sharing links and collaboration)\n      allow get: if isValidId(householdCode);\n\n      // Allow list queries for signed in users\n      allow list: if isSignedIn();\n\n      // Create: allow creating a new household with valid code\n      allow create: if isValidId(householdCode);\n\n      // Update: allow updating household data by valid code\n      allow update: if isValidId(householdCode);\n\n      // Delete: only authenticated owner can delete\n      allow delete: if isSignedIn() && isValidId(householdCode) && resource.data.ownerUid == request.auth.uid;\n    }"
