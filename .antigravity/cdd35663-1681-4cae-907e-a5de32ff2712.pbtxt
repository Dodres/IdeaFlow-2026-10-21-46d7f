    content: "\n  // Edit user names\n  const [danieleName, setDanieleName] = useState(household.users.daniele.name);\n  const [partnerName, setPartnerName] = useState(household.users.partner.name);\n  const [savedUsersNotice, setSavedUsersNotice] = useState(false);\n\n  const handleCopyCode = () => {\n    navigator.clipboard.writeText(household.code);\n    setCopiedCode(true);\n    setTimeout(() => setCopiedCode(false), 2000);\n  };\n\n  const handleCopyLink = () => {\n    const url = `${window.location.origin}/?code=${household.code}`;\n    navigator.clipboard.writeText(url);\n    setCopiedLink(true);\n    setTimeout(() => setCopiedLink(false), 2000);\n  };\n\n  const handleJoin = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!inputCode.trim()) return;\n    setIsJoining(true);\n    setJoinError(null);\n    const success = await joinHousehold(inputCode);\n    if (!success) {\n      setJoinError(\'Codice non valido o casa non trovata. Controlla il codice.\');\n    } else {\n      setInputCode(\'\');\n    }\n    setIsJoining(false);\n  };\n\n  const handleCreateSpace = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!spaceName.trim()) return;\n    await createNewHousehold(spaceName, customCode || undefined);\n    setIsCreatingSpace(false);\n    setSpaceName(\'\');\n    setCustomCode(\'\');\n  };\n\n  const handleAddLocation = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newLocationName.trim()) return;\n    await addHouseLocation(newLocationName, newLocationIcon);\n    setNewLocationName(\'\');\n  };\n\n  const handleSaveUserNames = async (e: React.FormEvent) => {\n    e.preventDefault();\n    await updateHousehold((prev) => ({\n      ...prev,\n      users: {\n        daniele: { ...prev.users.daniele, name: danieleName.trim() || \'Daniele\' },\n        partner: { ...prev.users.partner, name: partnerName.trim() || \'Partner\' },\n      },\n    }));\n    setSavedUsersNotice(true);\n    setTimeout(() => setSavedUsersNotice(false), 2000);\n  };\n\n  const houseLocations = household.houses || [\n    { id: \'casa_daniele\', name: \'Casa Daniele\', icon: \'\360\237\217\240\' },\n    { id: \'casa_partner\', name: \'Casa Partner\', icon: \'\360\237\217\241\' },\n  ];"
