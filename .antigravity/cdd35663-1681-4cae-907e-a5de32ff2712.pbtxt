 {/* CASE 3+ PEOPLE: Multi-group organizer button */}\\n        {numPeople >= 3 && (\\n          <button\\n            onClick={() => onOpenGroupingModal(groups)}\\n            className=\\\"px-2.5 py-1 text-[11px] font-semibold rounded-lg border border-app-primary-border bg-app-primary-light text-app-primary hover:opacity-90 transition-all flex items-center gap-1.5 cursor-pointer shadow-2xs\\\"\\n            title=\\\"Clicca per organizzare i gruppi a tavola (tutti insieme, tutti soli, o sotto-gruppi)\\\"\\n          >\\n            <SlidersHorizontal className=\\\"w-3 h-3\\\" />\\n            <span>\\n              {isAllTogether\\n                ? `\360\237\221\253 Tutti Insieme (${numPeople})`\\n                : isAllSeparate\\n                ? `\360\237\224\200 Tutti Soli (${numPeople})`\\n                : `\360\237\247\251 A Gruppi (${groups.length})`}\\n            </span>\\n          </button>\\n        )}\\n      </div>\", \"TargetFile\":\"/src/components/WeeklyMenu/WeeklyMenuView.tsx\", \"toolAction\":\"Updating DynamicMealSlotCard\", \"toolSummary\":\"Update DynamicMealSlotCard in WeeklyMenuView.tsx\"}"
