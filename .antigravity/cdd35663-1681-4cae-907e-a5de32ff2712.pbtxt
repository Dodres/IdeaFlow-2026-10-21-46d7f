  planner_response {
    thinking: "**Defining Component Specs**\n\nI\'m currently focused on outlining the `WeeklyMenu` component. I\'m carefully reviewing the specification to understand the specific feature requirements for the \"Menu Settiman\" functionality. I\'m breaking down the task into smaller, manageable subcomponents within `src/components/WeeklyMenu`.\n\n\n**Designing the `AddDishModal`**\n\nI\'ve moved on to designing the `AddDishModal`. My focus is on facilitating quick and intuitive dish selection. I\'m incorporating options for custom entries, recipe selection (including freshness status), and automatic ingredient addition to the shopping list. The target selector is also essential. I\'m planning the development of `src/components/WeeklyMenu/AddDishModal.tsx` next.\n\n\n"
    tool_calls {
      id: "call_2586577"
      name: "write_to_file"
      arguments_json: "{\"Append\":false,\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { X, Plus, Sparkles, BookOpen, Clock, Check } from \'lucide-react\';\\nimport { useHousehold } from \'../../context/HouseholdContext.tsx\';\\nimport { Recipe, DayKey, MealType } from \'../../types.ts\';\\nimport { SEASON_LABELS, getCurrentSeason } from \'../../data/initialData.ts\';\\n\\ninterface AddDishModalProps {\\n  isOpen: boolean;\\n  onClose: () => void;\\n  dayKey: DayKey;\\n  dayLabel: string;\\n  mealType: MealType;\\n  defaultTarget: \'together\' | \'daniele\' | \'partner\';\\n  onAdd: (dishName: string, target: \'together\' | \'daniele\' | \'partner\', recipe?: Recipe, addIngredients?: boolean) => void;\\n}\\n\\nexport const AddDishModal: React.FC<AddDishModalProps> = ({\\n  isOpen,\\n  onClose,\\n  dayKey,\\n  dayLabel,\\n  mealType,\\n  defaultTarget,\\n  onAdd,\\n}) => {\\n  const { household } = useHousehold();\\n  const [tab, setTab] = useState<\'custom\' | \'recipes\'>(\'custom\');\\n  const [dishName, setDishName] = useState(\'\');\\n  const [target, setTarget] = useState<\'together\' | \'daniele\' | \'partner\'>(defaultTarget);\\n  const [autoIngredients, setAutoIngredients] = useState(true);\\n  const [selectedRecipe, setSelectedRecipe] = useState<Recipe | null>(null);\\n  const [recipeSearch, setRecipeSearch] = useState(\'\');\\n\\n  if (!isOpen) return null;\\n\\n  const currentSeason = getCurrentSeason();\\n\\n  // Freshness calculation\\n  const getFreshnessStatus = (r: Recipe) => {\\n    if (!r.lastPreparedDate) return { isFresh: true, text: \'Non preparato di recente\' };\\n    const diffDays = Math.floor((new Date().getTime() - new Date(r.lastPreparedDate).getTime()) / (1000 * 3600 * 24));\\n    if (diffDays <= 7) return { isFresh: false, text: `Cucinato ${diffDays} gg fa` };\\n    if (diffDays <= 14) return { isFresh: false, text: `Cucinato ${diffDays} gg fa` };\\n    return { isFresh: true, text: `Preparato ${diffDays} gg fa` };\\n  };\\n\\n  const filteredRecipes = household.recipes.filter((r) =>\\n    r.name.toLowerCase().includes(recipeSearch.toLowerCase()) ||\\n    r.ingredients.some((i) => i.toLowerCase().includes(recipeSearch.toLowerCase()))\\n  );\\n\\n  const handleSubmit = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (tab === \'custom\') {\\n      if (!dishName.trim()) return;\\n      onAdd(dishName.trim(), target, undefined, false);\\n    } else {\\n      if (!selectedRecipe) return;\\n      onAdd(selectedRecipe.name, target, selectedRecipe, autoIngredients);\\n    }\\n    onClose();\\n  };\\n\\n  return (\\n    <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-xs\\\">\\n      <div className=\\\"bg-app-card rounded-2xl border border-app-subtle shadow-xl w-full max-w-lg overflow-hidden flex flex-col max-h-[90vh]\\\">\\n        {/* Header */}\\n        <div className=\\\"p-4 border-b border-app-subtle flex items-center justify-between\\\">\\n          <div>\\n            <h2 className=\\\"font-bold text-base text-app-main\\\">\\n              Aggiungi Piatto\\n            </h2>\\n            <p className=\\\"text-xs text-app-muted\\\">\\n              {dayLabel} \302\267 {mealType === \'pranzo\' ? \'Pranzo\' : \'Cena\'}\\n            </p>\\n          </div>\\n          <button\\n            onClick={onClose}\\n            className=\\\"p-1 rounded-lg text-app-muted hover:text-app-main hover:bg-app-muted transition-colors\\\"\\n          >\\n            <X className=\\\"w-5 h-5\\\" />\\n          </button>\\n        </div>\\n\\n        {/* Target Slot Selector */}\\n        <div className=\\\"px-4 pt-3 pb-2 border-b border-app-subtle bg-app-muted/30\\\">\\n          <label className=\\\"text-xs font-semibold text-app-muted block mb-1.5\\\">\\n            Assegna a:\\n          </label>\\n          <div className=\\\"grid grid-cols-3 gap-2\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setTarget(\'together\')}\\n              className={`py-2 px-2 text-xs font-semibold rounded-lg border transition-all ${\\n                target === \'together\'\\n                  ? \'bg-app-primary text-white border-app-primary shadow-xs\'\\n                  : \'bg-app-card text-app-main border-app-subtle hover:bg-app-muted\'\\n              }`}\\n            >\\n              \360\237\221\253 Insieme\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setTarget(\'daniele\')}\\n              className={`py-2 px-2 text-xs font-semibold rounded-lg border transition-all ${\\n                target === \'daniele\'\\n                  ? \'bg-app-primary text-white border-app-primary shadow-xs\'\\n                  : \'bg-app-card text-app-main border-app-subtle hover:bg-app-muted\'\\n              }`}\\n            >\\n              {household.users.daniele.avatar} {household.users.daniele.name}\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setTarget(\'partner\')}\\n              className={`py-2 px-2 text-xs font-semibold rounded-lg border transition-all ${\\n                target === \'partner\'\\n                  ? \'bg-app-primary text-white border-app-primary shadow-xs\'\\n                  : \'bg-app-card text-app-main border-app-subtle hover:bg-app-muted\'\\n              }`}\\n            >\\n              {household.users.partner.avatar} {household.users.partner.name}\\n            </button>\\n          </div>\\n        </div>\\n\\n        {/* Mode Tabs */}\\n        <div className=\\\"flex border-b border-app-subtle px-4\\\">\\n          <button\\n            onClick={() => setTab(\'custom\')}\\n            className={`py-2.5 px-3 text-xs font-semibold border-b-2 transition-colors ${\\n              tab === \'custom\'\\n                ? \'border-app-primary text-app-primary\'\\n                : \'border-transparent text-app-muted hover:text-app-main\'\\n            }`}\\n          >\\n            Scrittura libera\\n          </button>\\n          <button\\n            onClick={() => setTab(\'recipes\')}\\n            className={`py-2.5 px-3 text-xs font-semibold border-b-2 transition-colors flex items-center gap-1.5 ${\\n              tab === \'recipes\'\\n                ? \'border-app-primary text-app-primary\'\\n                : \'border-transparent text-app-muted hover:text-app-main\'\\n            }`}\\n          >\\n            <BookOpen className=\\\"w-3.5 h-3.5\\\" />\\n            <span>Dal Ricettario ({household.recipes.length})</span>\\n          </button>\\n        </div>\\n\\n        {/* Content Body */}\\n        <form onSubmit={handleSubmit} className=\\\"p-4 flex-1 overflow-y-auto space-y-4\\\">\\n          {tab === \'custom\' ? (\\n            <div>\\n              <label className=\\\"text-xs font-semibold text-app-main block mb-1\\\">\\n                Nome del piatto\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                autoFocus\\n                placeholder=\\\"es. Pasta alla Nerano, Bistecca con insalata...\\\"\\n                value={dishName}\\n                onChange={(e) => setDishName(e.target.value)}\\n                className=\\\"w-full px-3 py-2 text-sm rounded-xl border border-app-subtle bg-app-card text-app-main focus:border-app-primary focus:ring-1 focus:ring-app-primary outline-hidden\\\"\\n              />\\n              <p className=\\\"text-[11px] text-app-muted mt-1.5\\\">\\n                Puoi inserire qualsiasi piatto rapido. Per gestire ingredienti automatici, usa il ricettario.\\n              </p>\\n            </div>\\n          ) : (\\n            <div className=\\\"space-y-3\\\">\\n              <input\\n                type=\\\"text\\\"\\n                placeholder=\\\"Cerca per nome o ingrediente...\\\"\\n                value={recipeSearch}\\n                onChange={(e) => setRecipeSearch(e.target.value)}\\n                className=\\\"w-full px-3 py-1.5 text-xs rounded-lg border border-app-subtle bg-app-card text-app-main outline-hidden\\\"\\n              />\\n\\n              <div className=\\\"space-y-2 max-h-60 overflow-y-auto pr-1\\\">\\n                {filteredRecipes.map((recipe) => {\\n                  const freshness = getFreshnessStatus(recipe);\\n                  const isMatchSeason = recipe.season === currentSeason || recipe.season === \'all_year\';\\n                  const isSelected = selectedRecipe?.id === recipe.id;\\n\\n                  return (\\n                    <div\\n                      key={recipe.id}\\n                      onClick={() => setSelectedRecipe(recipe)}\\n                      className={`p-3 rounded-xl border cursor-pointer transition-all ${\\n                        isSelected\\n                          ? \'border-app-primary bg-app-primary-light shadow-xs\'\\n                          : \'border-app-subtle bg-app-card hover:bg-app-muted/50\'\\n                      }`}\\n                    >\\n                      <div className=\\\"flex items-start justify-between gap-2\\\">\\n                        <div>\\n                          <div className=\\\"font-semibold text-xs text-app-main\\\">\\n                            {recipe.name}\\n                          </div>\\n                          <div className=\\\"text-[11px] text-app-muted flex items-center gap-2 mt-0.5\\\">\\n                            <span>{SEASON_LABELS[recipe.season]?.icon} {SEASON_LABELS[recipe.season]?.label}</span>\\n                            <span>\302\267</span>\\n                            <span>{recipe.category}</span>\\n                            <span>\302\267</span>\\n                            <span className=\\\"flex items-center gap-0.5\\\">\\n                              <Clock className=\\\"w-3 h-3\\\" /> {recipe.prepTime}\\n                            </span>\\n                          </div>\\n                        </div>\\n\\n                        {isSelected ? (\\n                          <div className=\\\"w-5 h-5 rounded-full bg-app-primary text-white flex items-center justify-center shrink-0\\\">\\n                            <Check className=\\\"w-3.5 h-3.5\\\" />\\n                          </div>\\n                        ) : (\\n                          <span\\n                            className={`text-[10px] font-medium px-1.5 py-0.5 rounded-sm shrink-0 ${\\n                              freshness.isFresh\\n                                ? \'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300\'\\n                                : \'bg-amber-50 text-amber-700 dark:bg-amber-950/60 dark:text-amber-300\'\\n                            }`}\\n                          >\\n                            {freshness.text}\\n                          </span>\\n                        )}\\n                      </div>\\n\\n                      {recipe.ingredients.length > 0 && (\\n                        <div className=\\\"text-[10px] text-app-muted mt-2 line-clamp-1\\\">\\n                          \360\237\233\222 {recipe.ingredients.join(\', \')}\\n                        </div>\\n                      )}\\n                    </div>\\n                  );\\n                })}\\n              </div>\\n\\n              {selectedRecipe && (\\n                <label className=\\\"flex items-center gap-2 text-xs text-app-main pt-2 cursor-pointer border-t border-app-subtle\\\">\\n                  <input\\n                    type=\\\"checkbox\\\"\\n                    checked={autoIngredients}\\n                    onChange={(e) => setAutoIngredients(e.target.checked)}\\n                    className=\\\"w-4 h-4 rounded-sm text-app-primary accent-[var(--primary)]\\\"\\n                  />\\n                  <span>\\n                    Aggiungi automaticamente gli ingredienti ({selectedRecipe.ingredients.length}) alla Lista della Spesa\\n                  </span>\\n                </label>\\n              )}\\n            </div>\\n          )}\\n\\n          {/* Footer Submit */}\\n          <div className=\\\"pt-2 flex justify-end gap-2 border-t border-app-subtle\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onClose}\\n              className=\\\"px-4 py-2 text-xs font-semibold rounded-xl text-app-muted hover:bg-app-muted transition-colors\\\"\\n            >\\n              Annulla\\n            </button>\\n            <button\\n              type=\\\"submit\\\"\\n              disabled={tab === \'custom\' ? !dishName.trim() : !selectedRecipe}\\n              className=\\\"px-5 py-2 text-xs font-bold rounded-xl bg-app-primary text-white hover:opacity-90 transition-opacity disabled:opacity-40 shadow-xs\\\"\\n            >\\n              Aggiungi al Menu\\n            </button>\\n          </div>\\n        </form>\\n      </div>\\n    </div>\\n  );\\n};\\n\",\"Description\":\"Modal to add custom dishes or choose from personal recipes with freshness indicator and auto-shopping sync\",\"Overwrite\":true,\"TargetFile\":\"/src/components/WeeklyMenu/AddDishModal.tsx\",\"toolAction\":\"Creating AddDishModal component\",\"toolSummary\":\"Create AddDishModal.tsx\"}"
      thought_signature: ""
