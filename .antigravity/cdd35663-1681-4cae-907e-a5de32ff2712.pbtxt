    content: "        { id: \'daniele\', name: household.users.daniele?.name || \'Daniele\', avatar: household.users.daniele?.avatar || \'\360\237\221\250\342\200\215\360\237\215\263\' },\n        { id: \'partner\', name: household.users.partner?.name || \'Partner\', avatar: household.users.partner?.avatar || \'\360\237\221\251\342\200\215\360\237\214\276\' },\n      ];\n    }\n    return [{ id: \'daniele\', name: \'Daniele\', avatar: \'\360\237\221\250\342\200\215\360\237\215\263\' }];\n  }, [household.members, household.users]);\n\n  // Apply theme to HTML tag\n  useEffect(() => {\n    const root = document.documentElement;\n    root.setAttribute(\'data-theme\', colorTheme);\n\n    const isDark =\n      displayMode === \'dark\' ||\n      (displayMode === \'auto\' && window.matchMedia(\'(prefers-color-scheme: dark)\').matches);\n\n    if (isDark) {\n      root.classList.add(\'dark\');\n    } else {\n      root.classList.remove(\'dark\');\n    }\n  }, [colorTheme, displayMode]);\n\n  // Handle system dark mode changes if mode === \'auto\'\n  useEffect(() => {\n    if (displayMode !== \'auto\') return;\n    const media = window.matchMedia(\'(prefers-color-scheme: dark)\');\n    const listener = (e: MediaQueryListEvent) => {\n      if (e.matches) {\n        document.documentElement.classList.add(\'dark\');\n      } else {\n        document.documentElement.classList.remove(\'dark\');\n      }\n    };\n    media.addEventListener(\'change\', listener);\n    return () => media.removeEventListener(\'change\', listener);\n  }, [displayMode]);\n\n  const setCurrentRole = (role: string) => {\n    setCurrentRoleState(role);\n    localStorage.setItem(ROLE_STORAGE_KEY, role);\n  };\n\n  const setColorTheme = (theme: ColorTheme) => {\n    setColorThemeState(theme);\n    localStorage.setItem(THEME_STORAGE_KEY, theme);\n  };\n\n  const setDisplayMode = (mode: DisplayMode) => {\n    setDisplayModeState(mode);\n    localStorage.setItem(MODE_STORAGE_KEY, mode);\n  };\n\n  const setHouseholdCode = (code: string) => {\n    const upper = code.trim().toUpperCase();\n    setHouseholdCodeState(upper);\n    localStorage.setItem(CODE_STORAGE_KEY, upper);\n  };\n\n  const registerSavedHousehold = (code: string, name: string) => {\n    setSavedHouseholds((prev) => {\n      const filtered = prev.filter((h) => h.code !== code);\n      const updated = [{ code, name }, ...filtered];\n      localStorage.setItem(SAVED_HOUSES_KEY, JSON.stringify(updated));\n      return updated;\n    });\n  };\n\n  const removeSavedHousehold = (code: string) => {\n    setSavedHouseholds((prev) => {\n      const updated = prev.filter((h) => h.code !== code);\n      localStorage.setItem(SAVED_HOUSES_KEY, JSON.stringify(updated));\n      return updated;\n    });\n  };\n\n  // Fetch initial household data\n  const fetchHousehold = useCallback(async (code: string) => {\n    try {\n      setIsLoading(true);\n      const res = await fetch(`/api/households/${code}`);\n      if (res.ok) {\n        const data = await res.json();\n        if (!data.houses || data.houses.length === 0) {\n          data.houses = [\n            { id: \'casa_daniele\', name: \'Casa Daniele\', icon: \'\360\237\217\240\' },\n            { id: \'casa_partner\', name: \'Casa Partner\', icon: \'\360\237\217\241\' },\n          ];\n        }\n        if (!data.members || data.members.length === 0) {\n          if (data.users) {\n            data.members = [\n              { id: \'daniele\', name: data.users.daniele?.name || \'Daniele\', avatar: data.users.daniele?.avatar || \'\360\237\221\250\342\200\215\360\237\215\263\' },\n              { id: \'partner\', name: data.users.partner?.name || \'Partner\', avatar: data.users.partner?.avatar || \'\360\237\221\251\342\200\215\360\237\214\276\' },\n            ];\n          } else {\n            data.members = [{ id: \'daniele\', name: \'Daniele\', avatar: \'\360\237\221\250\342\200\215\360\237\215\263\' }];\n          }\n        }\n        setHousehold(data);\n        registerSavedHousehold(data.code, data.name || data.code);\n      } else if (res.status === 404) {\n        console.warn(`Household ${code} not found, initializing...`);\n      }\n    } catch (err) {\n      console.error(\'Fetch household error:\', err);\n    } finally {\n      setIsLoading(false);\n    }\n  }, []);\n\n  useEffect(() => {\n    fetchHousehold(householdCode);\n  }, [householdCode, fetchHousehold]);\n\n  // Real-time SSE connection\n  useEffect(() => {\n    let eventSource: EventSource | null = null;\n    let reconnectTimeout: any = null;\n"
