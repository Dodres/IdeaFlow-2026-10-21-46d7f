  view_file {
    absolute_path_uri: "file:///src/context/HouseholdContext.tsx"
    start_line: 569
    end_line: 624
    content: "    customCode?: string,\n    danieleName?: string,\n    partnerName?: string\n  ): Promise<string> => {\n    try {\n      setIsLoading(true);\n      const chars = \'ABCDEFGHJKLMNPQRSTUVWXYZ23456789\';\n      let autoCode = \'\';\n      for (let i = 0; i < 6; i++) {\n        autoCode += chars.charAt(Math.floor(Math.random() * chars.length));\n      }\n      const code = (customCode ? String(customCode).trim().toUpperCase() : autoCode).slice(0, 10);\n      const newHh = createInitialHousehold(code);\n      newHh.name = name;\n\n      if (user) {\n        newHh.ownerUid = user.uid;\n        newHh.memberUids = [user.uid];\n        newHh.members = [\n          {\n            id: user.uid,\n            name: user.displayName || \'Io\',\n            avatar: \'\360\237\221\221\',\n          },\n        ];\n      } else if (danieleName && newHh.users) {\n        newHh.users.daniele.name = danieleName;\n      }\n\n      // Save to Firestore\n      try {\n        await setDoc(doc(db, \'households\', code), cleanForFirestore(newHh));\n      } catch (e) {\n        console.warn(\'Firestore create note:\', e);\n      }\n\n      // Save to server\n      try {\n        await fetch(\'/api/households\', {\n          method: \'POST\',\n          headers: { \'Content-Type\': \'application/json\' },\n          body: JSON.stringify({ name, customCode: code, danieleName, partnerName }),\n        });\n      } catch {}\n\n      // Add to user profile if logged in\n      if (user) {\n        try {\n          await updateDoc(doc(db, \'users\', user.uid), {\n            households: arrayUnion(code),\n          });\n        } catch {}\n      }\n\n      setHousehold(newHh);\n      setHouseholdCode(code);"
    num_lines: 1212
    num_bytes: 37003
    line_range_bytes: 1614
  }
