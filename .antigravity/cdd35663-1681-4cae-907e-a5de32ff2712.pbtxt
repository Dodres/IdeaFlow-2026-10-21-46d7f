    content: "    }\n    return () => document.removeEventListener(\'mousedown\', handleClickOutside);\n  }, [isHouseMenuOpen]);\n\n  const pendingShoppingCount = household.shoppingList.filter((i) => !i.isDone).length;\n  const currentPerson = members.find((m) => m.id === currentRole) || members[0];\n  const currentUserName = currentPerson ? currentPerson.name : \'Daniele\';\n  const currentUserAvatar = currentPerson ? currentPerson.avatar : \'\360\237\221\250\342\200\215\360\237\215\263\';\n\n  const handleSelectHouse = async (code: string) => {\n    setIsHouseMenuOpen(false);\n    if (code !== householdCode) {\n      await switchHousehold(code);\n    }\n  };\n"
