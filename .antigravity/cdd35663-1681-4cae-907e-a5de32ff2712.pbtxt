    use_fast_apply: true
    replacement_infos {
      original_chunk {
        target_content: "      {/* 3. Profilo Utente & Nomi */}\n      <section className=\"bg-app-card rounded-2xl border border-app-subtle p-4 sm:p-6 shadow-xs space-y-4\">\n        <div className=\"flex items-center gap-2.5 border-b border-app-subtle pb-3\">\n          <div className=\"w-8 h-8 rounded-xl bg-app-primary-light text-app-primary flex items-center justify-center font-bold\">\n            <UserCheck className=\"w-4 h-4\" />\n          </div>\n          <div>\n            <h2 className=\"font-bold text-base text-app-main tracking-tight\">\n              Profilo Utente su questo Smartphone\n            </h2>\n            <p className=\"text-xs text-app-muted\">\n              Identit\303\240 per i pasti separati e per la spunta dei prodotti\n            </p>\n          </div>\n        </div>\n\n        {/* Current Active User Selection */}\n        <div>\n          <label className=\"text-xs font-bold text-app-main block mb-2\">\n            Questo smartphone appartiene a:\n          </label>\n          <div className=\"grid grid-cols-2 gap-3\">\n            <button\n              type=\"button\"\n              onClick={() => setCurrentRole(\'daniele\')}\n              className={`p-3 rounded-xl border text-left transition-all cursor-pointer flex items-center gap-3 ${\n                currentRole === \'daniele\'\n                  ? \'border-app-primary bg-app-primary-light shadow-xs\'\n                  : \'border-app-subtle bg-app-card hover:bg-app-muted\'\n              }`}\n            >\n              <span className=\"text-2xl\">{household.users.daniele.avatar}</span>\n              <div>\n                <span className=\"font-bold text-xs text-app-main block\">\n                  {household.users.daniele.name}\n                </span>\n                <span className=\"text-[10px] text-app-muted\">\n                  {currentRole === \'daniele\' ? \'Attivo su questo telefono\' : \'Clicca per attivare\'}\n                </span>\n              </div>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => setCurrentRole(\'partner\')}\n              className={`p-3 rounded-xl border text-left transition-all cursor-pointer flex items-center gap-3 ${\n                currentRole === \'partner\'\n                  ? \'border-app-primary bg-app-primary-light shadow-xs\'\n                  : \'border-app-subtle bg-app-card hover:bg-app-muted\'\n              }`}\n            >\n              <span className=\"text-2xl\">{household.users.partner.avatar}</span>\n              <div>\n                <span className=\"font-bold text-xs text-app-main block\">\n                  {household.users.partner.name}\n                </span>\n                <span className=\"text-[10px] text-app-muted\">\n                  {currentRole === \'partner\' ? \'Attivo su questo telefono\' : \'Clicca per attivare\'}\n                </span>\n              </div>\n            </button>\n          </div>\n        </div>\n\n        {/* Rename Users */}\n        <form onSubmit={handleSaveUserNames} className=\"pt-2 border-t border-app-subtle space-y-3 text-xs\">\n          <label className=\"font-bold text-app-main block\">\n            Personalizza i nomi della coppia:\n          </label>\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n            <div>\n              <span className=\"text-[11px] text-app-muted block mb-1\">Nome Utente 1 (Daniele)</span>\n              <input\n                type=\"text\"\n                value={danieleName}\n                onChange={(e) => setDanieleName(e.target.value)}\n                className=\"w-full px-3 py-1.5 rounded-lg border border-app-subtle bg-app-card text-app-main outline-hidden\"\n              />\n            </div>\n            <div>\n              <span className=\"text-[11px] text-app-muted block mb-1\">Nome Utente 2 (Partner)</span>\n              <input\n                type=\"text\"\n                value={partnerName}\n                onChange={(e) => setPartnerName(e.target.value)}\n                className=\"w-full px-3 py-1.5 rounded-lg border border-app-subtle bg-app-card text-app-main outline-hidden\"\n              />\n            </div>\n          </div>\n          <div className=\"flex items-center justify-between pt-1\">\n            {savedUsersNotice && (\n              <span className=\"text-[11px] text-emerald-600 font-semibold flex items-center gap-1\">\n                <Check className=\"w-3.5 h-3.5\" /> Nomi aggiornati e sincronizzati!\n              </span>\n            )}\n            <button\n              type=\"submit\"\n              className=\"ml-auto px-4 py-1.5 bg-app-card border border-app-subtle hover:bg-app-muted font-bold text-app-main rounded-lg transition-colors cursor-pointer\"\n            >\n              Salva Nomi\n            </button>\n          </div>\n        </form>\n      </section>"
        replacement_content: "      {/* 3. Persone Associate a questa Casa (1, 2, o pi\303\271 persone) */}\n      <section className=\"bg-app-card rounded-2xl border border-app-subtle p-4 sm:p-6 shadow-xs space-y-4\">\n        <div className=\"flex items-center justify-between border-b border-app-subtle pb-3\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-8 h-8 rounded-xl bg-app-primary-light text-app-primary flex items-center justify-center font-bold\">\n              <UserCheck className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h2 className=\"font-bold text-base text-app-main tracking-tight\">\n                Persone Associate a questa Casa ({members.length})\n              </h2>\n              <p className=\"text-xs text-app-muted\">\n                Gestisci chi vive o mangia in questa casa (1 persona, coppia o gruppo)\n              </p>\n            </div>\n          </div>\n        </div>\n\n        {/* Dynamic explanation banner */}\n        <div className=\"p-3 rounded-xl bg-app-muted/50 border border-app-subtle text-xs text-app-muted space-y-1\">\n          <span className=\"font-bold text-app-main block\">\n            \360\237\222\241 Come si adatta il Menu in base al numero di persone:\n          </span>\n          {members.length === 1 && (\n            <p className=\"text-app-main font-medium\">\n              \360\237\221\211 <strong>1 persona associata:</strong> Nel menu non compare \"insieme/separati\", pianifichi direttamente i tuoi piatti personali.\n            </p>\n          )}\n          {members.length === 2 && (\n            <p className=\"text-app-main font-medium\">\n              \360\237\221\211 <strong>2 persone associate:</strong> Per ogni pasto puoi scegliere tra <strong>\360\237\221\253 Insieme</strong> o <strong>\360\237\224\200 Pasti Separati</strong>.\n            </p>\n          )}\n          {members.length >= 3 && (\n            <p className=\"text-app-main font-medium\">\n              \360\237\221\211 <strong>{members.length} persone associate:</strong> Puoi organizzare i pasti in sotto-gruppi (es. tutti insieme, ciascuno per s\303\251, oppure 2 insieme e 1 solo, ecc.)!\n            </p>\n          )}\n        </div>\n\n        {/* Current Members Cards */}\n        <div className=\"space-y-2\">\n          <label className=\"text-xs font-bold text-app-main block\">\n            Chi usa questo smartphone adesso:\n          </label>\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2.5\">\n            {members.map((person) => {\n              const isActive = currentRole === person.id;\n              return (\n                <div\n                  key={person.id}\n                  onClick={() => setCurrentRole(person.id)}\n                  className={`p-3 rounded-xl border flex items-center justify-between transition-all cursor-pointer ${\n                    isActive\n                      ? \'border-app-primary bg-app-primary-light shadow-xs\'\n                      : \'border-app-subtle bg-app-card hover:bg-app-muted\'\n                  }`}\n                >\n                  <div className=\"flex items-center gap-3 min-w-0\">\n                    <span className=\"text-2xl\">{person.avatar}</span>\n                    <div className=\"min-w-0\">\n                      <span className={`font-bold text-xs block truncate ${isActive ? \'text-app-primary\' : \'text-app-main\'}`}>\n                        {person.name}\n                      </span>\n                      <span className=\"text-[10px] text-app-muted\">\n                        {isActive ? \'Attivo su questo telefono\' : \'Tocca per attivare\'}\n                      </span>\n                    </div>\n                  </div>\n\n                  <div className=\"flex items-center gap-1.5 shrink-0\">\n                    {isActive ? (\n                      <span className=\"w-5 h-5 rounded-full bg-app-primary text-white flex items-center justify-center\">\n                        <Check className=\"w-3.5 h-3.5\" />\n                      </span>\n                    ) : (\n                      members.length > 1 && (\n                        <button\n                          type=\"button\"\n                          onClick={(e) => {\n                            e.stopPropagation();\n                            removeMember(person.id);\n                          }}\n                          className=\"p-1.5 text-app-muted hover:text-rose-500 rounded-lg hover:bg-rose-50 dark:hover:bg-rose-950/40 cursor-pointer\"\n                          title=\"Rimuovi persona da questa casa\"\n                        >\n                          <Trash2 className=\"w-3.5 h-3.5\" />\n                        </button>\n                      )\n                    )}\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Add Person Form */}\n        <div className=\"pt-3 border-t border-app-subtle space-y-2\">\n          <span className=\"text-xs font-bold text-app-main block\">\n            Aggiungi un\'altra persona a questa casa:\n          </span>\n          <AddMemberForm onAdd={addMember} />\n        </div>\n      </section>"
        start_line: 419
        end_line: 523
      }
      num_matches: 1
    }
    description: "Upgrade User Profiles section in SettingsView to dynamic multi-person manager"
    diff_stats {
