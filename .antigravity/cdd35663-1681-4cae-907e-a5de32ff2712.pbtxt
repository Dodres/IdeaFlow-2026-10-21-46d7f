    replacement_infos {
      original_chunk {
        target_content: "export const ShoppingListView: React.FC = () => {\n  const {\n    household,\n    toggleShoppingItem,\n    addShoppingItem,\n    deleteShoppingItem,\n    clearCompletedShopping,\n    currentRole,\n  } = useHousehold();\n\n  // Controls state\n  const [groupMode, setGroupMode] = useState<GroupMode>(\'reparto\');\n  const [filterAssignee, setFilterAssignee] = useState<FilterAssignee>(\'all\');\n  const [quickInput, setQuickInput] = useState(\'\');\n  const [quickAssignee, setQuickAssignee] = useState<Assignee>(\'together\');\n  const [isAdding, setIsAdding] = useState(false);\n\n  const danieleName = household.users.daniele.name;\n  const partnerName = household.users.partner.name;\n\n  // Filter items by assignee\n  const filteredItems = useMemo(() => {\n    return household.shoppingList.filter((item) => {\n      if (filterAssignee === \'all\') return true;\n      if (filterAssignee === \'together\') return item.assignee === \'together\';\n      if (filterAssignee === \'mine\') return item.assignee === currentRole;\n      if (filterAssignee === \'partner\') {\n        const otherRole = currentRole === \'daniele\' ? \'partner\' : \'daniele\';\n        return item.assignee === otherRole;\n      }\n      return true;\n    });\n  }, [household.shoppingList, filterAssignee, currentRole]);\n\n  // Counts\n  const totalCount = filteredItems.length;\n  const doneCount = filteredItems.filter((i) => i.isDone).length;\n  const pendingCount = totalCount - doneCount;\n\n  // Quick Add submit\n  const handleQuickAdd = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!quickInput.trim() || isAdding) return;\n    try {\n      setIsAdding(true);\n      await addShoppingItem({\n        name: quickInput.trim(),\n        assignee: quickAssignee,\n        dishName: \'Fuori lista\',\n      });\n      setQuickInput(\'\');\n    } finally {\n      setIsAdding(false);\n    }\n  };\n\n  // Assignee badge styling\n  const renderAssigneeBadge = (assignee: Assignee) => {\n    if (assignee === \'together\') {\n      return (\n        <span className=\"text-[10px] font-semibold text-emerald-700 bg-emerald-50 dark:bg-emerald-950/60 dark:text-emerald-300 px-2 py-0.5 rounded-md\">\n          Insieme\n        </span>\n      );\n    }\n    if (assignee === \'daniele\') {\n      return (\n        <span className=\"text-[10px] font-semibold text-sky-700 bg-sky-50 dark:bg-sky-950/60 dark:text-sky-300 px-2 py-0.5 rounded-md\">\n          {household.users.daniele.avatar} {danieleName}\n        </span>\n      );\n    }\n    return (\n      <span className=\"text-[10px] font-semibold text-purple-700 bg-purple-50 dark:bg-purple-950/60 dark:text-purple-300 px-2 py-0.5 rounded-md\">\n        {household.users.partner.avatar} {partnerName}\n      </span>\n    );\n  };\n\n  return (\n    <div className=\"space-y-6 pb-24\">\n      {/* Quick Add Form Bar */}\n      <div className=\"bg-app-card rounded-2xl border border-app-subtle p-3 sm:p-4 shadow-xs\">\n        <form onSubmit={handleQuickAdd} className=\"space-y-3\">\n          <div className=\"flex gap-2\">\n            <input\n              type=\"text\"\n              placeholder=\"Aggiungi prodotto (es. Pane fresco, Basilico, Pomodori)...\"\n              value={quickInput}\n              onChange={(e) => setQuickInput(e.target.value)}\n              className=\"flex-1 px-3.5 py-2.5 text-sm rounded-xl border border-app-subtle bg-app-card text-app-main focus:border-app-primary focus:ring-1 focus:ring-app-primary outline-hidden\"\n            />\n            <button\n              type=\"submit\"\n              disabled={!quickInput.trim() || isAdding}\n              className=\"px-4 py-2.5 rounded-xl bg-app-primary text-white font-bold text-xs flex items-center gap-1.5 hover:opacity-90 transition-opacity disabled:opacity-40 shadow-xs cursor-pointer\"\n            >\n              <Plus className=\"w-4 h-4\" />\n              <span className=\"hidden sm:inline\">Aggiungi</span>\n            </button>\n          </div>\n\n          {/* Quick Assignee Choice */}\n          <div className=\"flex items-center justify-between text-xs pt-1\">\n            <div className=\"flex items-center gap-1.5 flex-wrap\">\n              <span className=\"text-app-muted text-[11px] font-medium mr-1\">\n                Chi compra:\n              </span>\n              <button\n                type=\"button\"\n                onClick={() => setQuickAssignee(\'together\')}\n                className={`px-2.5 py-1 rounded-lg text-[11px] font-semibold transition-all cursor-pointer ${\n                  quickAssignee === \'together\'\n                    ? \'bg-app-primary text-white shadow-xs\'\n                    : \'bg-app-muted text-app-muted hover:text-app-main\'\n                }`}\n              >\n                Insieme\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setQuickAssignee(\'daniele\')}\n                className={`px-2.5 py-1 rounded-lg text-[11px] font-semibold transition-all cursor-pointer ${\n                  quickAssignee === \'daniele\'\n                    ? \'bg-app-primary text-white shadow-xs\'\n                    : \'bg-app-muted text-app-muted hover:text-app-main\'\n                }`}\n              >\n                {household.users.daniele.avatar} {danieleName}\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setQuickAssignee(\'partner\')}\n                className={`px-2.5 py-1 rounded-lg text-[11px] font-semibold transition-all cursor-pointer ${\n                  quickAssignee === \'partner\'\n                    ? \'bg-app-primary text-white shadow-xs\'\n                    : \'bg-app-muted text-app-muted hover:text-app-main\'\n                }`}\n              >\n                {household.users.partner.avatar} {partnerName}\n              </button>\n            </div>\n\n            <div className=\"flex items-center gap-2\">\n              <span className=\"text-[10px] text-app-muted hidden md:inline\">\n                \342\234\250 Reparto assegnato automaticamente da AI\n              </span>\n            </div>\n          </div>\n        </form>\n      </div>\n\n      {/* Filter & Grouping Controls */}\n      <div className=\"bg-app-card rounded-2xl border border-app-subtle p-3 sm:p-4 shadow-xs space-y-3\">\n        {/* Row 1: Assignee Filters */}\n        <div className=\"flex flex-wrap items-center justify-between gap-2\">\n          <div className=\"flex items-center gap-1 bg-app-muted p-1 rounded-xl\">\n            <button\n              onClick={() => setFilterAssignee(\'all\')}\n              className={`px-3 py-1.5 text-xs font-semibold rounded-lg transition-all cursor-pointer ${\n                filterAssignee === \'all\'\n                  ? \'bg-app-card text-app-main shadow-xs\'\n                  : \'text-app-muted hover:text-app-main\'\n              }`}\n            >\n              Tutto ({household.shoppingList.length})\n            </button>\n            <button\n              onClick={() => setFilterAssignee(\'together\')}\n              className={`px-3 py-1.5 text-xs font-semibold rounded-lg transition-all cursor-pointer ${\n                filterAssignee === \'together\'\n                  ? \'bg-app-card text-app-main shadow-xs\'\n                  : \'text-app-muted hover:text-app-main\'\n              }`}\n            >\n              Solo Insieme\n            </button>\n            <button\n              onClick={() => setFilterAssignee(\'mine\')}\n              className={`px-3 py-1.5 text-xs font-semibold rounded-lg transition-all cursor-pointer ${\n                filterAssignee === \'mine\'\n                  ? \'bg-app-card text-app-main shadow-xs\'\n                  : \'text-app-muted hover:text-app-main\'\n              }`}\n            >\n              Solo mia spesa\n            </button>\n            <button\n              onClick={() => setFilterAssignee(\'partner\')}\n              className={`px-3 py-1.5 text-xs font-semibold rounded-lg transition-all cursor-pointer ${\n                filterAssignee === \'partner\'\n                  ? \'bg-app-card text-app-main shadow-xs\'\n                  : \'text-app-muted hover:text-app-main\'\n              }`}\n            >\n              Solo spesa partner\n            </button>\n          </div>"
        replacement_content: "export const ShoppingListView: React.FC = () => {\n  const {\n    household,\n    members,\n    toggleShoppingItem,\n    addShoppingItem,\n    deleteShoppingItem,\n    clearCompletedShopping,\n    currentRole,\n  } = useHousehold();\n\n  // Controls state\n  const [groupMode, setGroupMode] = useState<GroupMode>(\'reparto\');\n  const [filterAssignee, setFilterAssignee] = useState<string>(\'all\');\n  const [quickInput, setQuickInput] = useState(\'\');\n  const [quickAssignee, setQuickAssignee] = useState<Assignee>(\'together\');\n  const [isAdding, setIsAdding] = useState(false);\n\n  const memberMap = useMemo(() => {\n    const map = new Map<string, (typeof members)[0]>();\n    members.forEach((m) => map.set(m.id, m));\n    return map;\n  }, [members]);\n\n  // Filter items by assignee\n  const filteredItems = useMemo(() => {\n    return household.shoppingList.filter((item) => {\n      if (filterAssignee === \'all\') return true;\n      if (filterAssignee === \'together\') return item.assignee === \'together\';\n      return item.assignee === filterAssignee;\n    });\n  }, [household.shoppingList, filterAssignee]);\n\n  // Counts\n  const totalCount = filteredItems.length;\n  const doneCount = filteredItems.filter((i) => i.isDone).length;\n  const pendingCount = totalCount - doneCount;\n\n  // Quick Add submit\n  const handleQuickAdd = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!quickInput.trim() || isAdding) return;\n    try {\n      setIsAdding(true);\n      const assignedTarget = members.length === 1 ? members[0].id : quickAssignee;\n      await addShoppingItem({\n        name: quickInput.trim(),\n        assignee: assignedTarget,\n        dishName: \'Fuori lista\',\n      });\n      setQuickInput(\'\');\n    } finally {\n      setIsAdding(false);\n    }\n  };\n\n  // Assignee badge styling\n  const renderAssigneeBadge = (assignee: Assignee) => {\n    if (members.length <= 1) {\n      return null;\n    }\n    if (assignee === \'together\') {\n      return (\n        <span className=\"text-[10px] font-semibold text-emerald-700 bg-emerald-50 dark:bg-emerald-950/60 dark:text-emerald-300 px-2 py-0.5 rounded-md\">\n          Insieme\n        </span>\n      );\n    }\n    const person = memberMap.get(assignee);\n    if (person) {\n      return (\n        <span className=\"text-[10px] font-semibold text-sky-700 bg-sky-50 dark:bg-sky-950/60 dark:text-sky-300 px-2 py-0.5 rounded-md\">\n          {person.avatar} {person.name}\n        </span>\n      );\n    }\n    if (assignee === \'daniele\') {\n      return (\n        <span className=\"text-[10px] font-semibold text-sky-700 bg-sky-50 dark:bg-sky-950/60 dark:text-sky-300 px-2 py-0.5 rounded-md\">\n          \360\237\221\250\342\200\215\360\237\215\263 Daniele\n        </span>\n      );\n    }\n    if (assignee === \'partner\') {\n      return (\n        <span className=\"text-[10px] font-semibold text-purple-700 bg-purple-50 dark:bg-purple-950/60 dark:text-purple-300 px-2 py-0.5 rounded-md\">\n          \360\237\221\251\342\200\215\360\237\214\276 Partner\n        </span>\n      );\n    }\n    return (\n      <span className=\"text-[10px] font-semibold text-app-muted bg-app-muted px-2 py-0.5 rounded-md\">\n        {assignee}\n      </span>\n    );\n  };\n\n  return (\n    <div className=\"space-y-6 pb-24\">\n      {/* Quick Add Form Bar */}\n      <div className=\"bg-app-card rounded-2xl border border-app-subtle p-3 sm:p-4 shadow-xs\">\n        <form onSubmit={handleQuickAdd} className=\"space-y-3\">\n          <div className=\"flex gap-2\">\n            <input\n              type=\"text\"\n              placeholder=\"Aggiungi prodotto (es. Pane fresco, Basilico, Pomodori)...\"\n              value={quickInput}\n              onChange={(e) => setQuickInput(e.target.value)}\n              className=\"flex-1 px-3.5 py-2.5 text-sm rounded-xl border border-app-subtle bg-app-card text-app-main focus:border-app-primary focus:ring-1 focus:ring-app-primary outline-hidden\"\n            />\n            <button\n              type=\"submit\"\n              disabled={!quickInput.trim() || isAdding}\n              className=\"px-4 py-2.5 rounded-xl bg-app-primary text-white font-bold text-xs flex items-center gap-1.5 hover:opacity-90 transition-opacity disabled:opacity-40 shadow-xs cursor-pointer\"\n            >\n              <Plus className=\"w-4 h-4\" />\n              <span className=\"hidden sm:inline\">Aggiungi</span>\n            </button>\n          </div>\n\n          {/* Quick Assignee Choice: only shown if 2 or more people */}\n          {members.length > 1 && (\n            <div className=\"flex items-center justify-between text-xs pt-1\">\n              <div className=\"flex items-center gap-1.5 flex-wrap\">\n                <span className=\"text-app-muted text-[11px] font-medium mr-1\">\n                  Chi compra:\n                </span>\n                <button\n                  type=\"button\"\n                  onClick={() => setQuickAssignee(\'together\')}\n                  className={`px-2.5 py-1 rounded-lg text-[11px] font-semibold transition-all cursor-pointer ${\n                    quickAssignee === \'together\'\n                      ? \'bg-app-primary text-white shadow-xs\'\n                      : \'bg-app-muted text-app-muted hover:text-app-main\'\n                  }`}\n                >\n                  Insieme\n                </button>\n                {members.map((m) => (\n                  <button\n                    key={m.id}\n                    type=\"button\"\n                    onClick={() => setQuickAssignee(m.id)}\n                    className={`px-2.5 py-1 rounded-lg text-[11px] font-semibold transition-all cursor-pointer ${\n                      quickAssignee === m.id\n                        ? \'bg-app-primary text-white shadow-xs\'\n                        : \'bg-app-muted text-app-muted hover:text-app-main\'\n                    }`}\n                  >\n                    {m.avatar} {m.name}\n                  </button>\n                ))}\n              </div>\n\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-[10px] text-app-muted hidden md:inline\">\n                  \342\234\250 Reparto assegnato automaticamente da AI\n                </span>\n              </div>\n            </div>\n          )}\n        </form>\n      </div>\n\n      {/* Filter & Grouping Controls */}\n      <div className=\"bg-app-card rounded-2xl border border-app-subtle p-3 sm:p-4 shadow-xs space-y-3\">\n        {/* Row 1: Assignee Filters (only if more than 1 person) */}\n        {members.length > 1 && (\n          <div className=\"flex flex-wrap items-center justify-between gap-2\">\n            <div className=\"flex items-center gap-1 bg-app-muted p-1 rounded-xl flex-wrap\">\n              <button\n                onClick={() => setFilterAssignee(\'all\')}\n                className={`px-3 py-1.5 text-xs font-semibold rounded-lg transition-all cursor-pointer ${\n                  filterAssignee === \'all\'\n                    ? \'bg-app-card text-app-main shadow-xs\'\n                    : \'text-app-muted hover:text-app-main\'\n                }`}\n              >\n                Tutto ({household.shoppingList.length})\n              </button>\n              <button\n                onClick={() => setFilterAssignee(\'together\')}\n                className={`px-3 py-1.5 text-xs font-semibold rounded-lg transition-all cursor-pointer ${\n                  filterAssignee === \'together\'\n                    ? \'bg-app-card text-app-main shadow-xs\'\n                    : \'text-app-muted hover:text-app-main\'\n                }`}\n              >\n                Solo Insieme\n              </button>\n              {members.map((m) => (\n                <button\n                  key={m.id}\n                  onClick={() => setFilterAssignee(m.id)}\n                  className={`px-3 py-1.5 text-xs font-semibold rounded-lg transition-all cursor-pointer ${\n                    filterAssignee === m.id\n                      ? \'bg-app-card text-app-main shadow-xs\'\n                      : \'text-app-muted hover:text-app-main\'\n                  }`}\n                >\n                  {m.avatar} Solo {m.name}\n                </button>\n              ))}\n            </div>\n          </div>\n        )}"
