    content: "    partnerDishes: [],\n  };\n\n  // Domenica: Lasagne + Minestrone leggero\n  menu.days.dom.pranzo = {\n    type: \'together\',\n    togetherDishes: [{ id: \'d_dom_p\', name: \'Lasagne Tradizionali della Domenica\', recipeId: \'rec_7\' }],\n    danieleDishes: [],\n    partnerDishes: [],\n  };\n  menu.days.dom.cena = {\n    type: \'together\',\n    togetherDishes: [{ id: \'d_dom_c\', name: \'Minestrone leggero autunnale con crostoni\' }],\n    danieleDishes: [],\n    partnerDishes: [],\n  };\n\n  return menu;\n}\n\nexport function createInitialHousehold(code = \'CASA01\'): Household {\n  const currentWeek = getCurrentWeekId();\n  const sampleWeek = createSampleWeekMenu(currentWeek);\n\n  return {\n    code,\n    name: \'Casa Nostra\',\n    members: [\n      { id: \'daniele\', name: \'Daniele\', avatar: \'\360\237\221\250\342\200\215\360\237\215\263\' },\n      { id: \'partner\', name: \'Partner\', avatar: \'\360\237\221\251\342\200\215\360\237\214\276\' },\n    ],\n    users: {\n      daniele: { name: \'Daniele\', avatar: \'\360\237\221\250\342\200\215\360\237\215\263\' },\n      partner: { name: \'Partner\', avatar: \'\360\237\221\251\342\200\215\360\237\214\276\' },\n    },\n    houses: [\n      { id: \'casa_daniele\', name: \'Casa Daniele\', icon: \'\360\237\217\240\' },\n      { id: \'casa_partner\', name: \'Casa Partner\', icon: \'\360\237\217\241\' },\n    ],\n    activeWeekId: currentWeek,\n    menus: {\n      [currentWeek]: sampleWeek,\n    },\n    shoppingList: [\n      {\n        id: \'sp_1\',\n        name: \'Zucca Mantovana\',\n        category: \'ortofrutta\',\n        assignee: \'together\',\n        dishName: \'Risotto alla Zucca\',\n        dayKey: \'mar\',\n        isDone: false,\n        createdAt: new Date().toISOString(),\n      },\n      {\n        id: \'sp_2\',\n        name: \'Funghi porcini\',\n        category: \'ortofrutta\',\n        assignee: \'together\',\n        dishName: \'Vellutata di Funghi\',\n        dayKey: \'mer\',\n        isDone: false,\n        createdAt: new Date().toISOString(),\n      },\n      {\n        id: \'sp_3\',\n        name: \'Pomodorini ciliegino\',\n        category: \'ortofrutta\',\n        assignee: \'together\',\n        dishName: \'Pasta al Pesto\',\n        dayKey: \'lun\',\n        isDone: true,\n        checkedBy: \'Daniele\',\n        checkedAt: new Date().toISOString(),\n        createdAt: new Date().toISOString(),\n      },\n      {\n        id: \'sp_4\',\n        name: \'Basilico fresco\',\n        category: \'ortofrutta\',\n        assignee: \'together\',"
