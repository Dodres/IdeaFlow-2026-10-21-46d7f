            lines {
              text: "export function getWeekDayDetails(weekId: string): Record<string, { dateNum: number; monthName: string; formattedDate: string; isToday: boolean }> {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const monday = getMondayOfIsoWeek(weekId);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const keys = [\'lun\', \'mar\', \'mer\', \'gio\', \'ven\', \'sab\', \'dom\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const today = new Date();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  today.setHours(0, 0, 0, 0);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const result: Record<string, { dateNum: number; monthName: string; formattedDate: string; isToday: boolean }> = {};"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  keys.forEach((key, index) => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const d = new Date(monday.getTime() + index * 86400000);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const isToday = d.getTime() === today.getTime();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    result[key] = {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      dateNum: d.getDate(),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
