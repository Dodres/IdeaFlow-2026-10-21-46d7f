    content: "import { Household, Recipe, WeekMenu, Season, Person, MealGroup, MealSlot } from \'../types.ts\';\n\nexport const DEPARTMENT_LABELS: Record<string, { label: string; icon: string; order: number }> = {\n  ortofrutta: { label: \'Ortofrutta\', icon: \'\360\237\245\225\', order: 1 },\n  macelleria_pescheria: { label: \'Macelleria / Pescheria\', icon: \'\360\237\245\251\', order: 2 },\n  latticini_freschi: { label: \'Latticini & Freschi\', icon: \'\360\237\247\200\', order: 3 },\n  dispensa_secco: { label: \'Dispensa & Secco\', icon: \'\360\237\214\276\', order: 4 },\n  surgelati: { label: \'Surgelati\', icon: \'\342\235\204\357\270\217\', order: 5 },\n  cura_casa_altro: { label: \'Cura casa & Altro\', icon: \'\360\237\247\274\', order: 6 },\n};\n\nexport const SEASON_LABELS: Record<Season, { label: string; icon: string }> = {\n  autumn: { label: \'Autunno\', icon: \'\360\237\215\202\' },\n  winter: { label: \'Inverno\', icon: \'\342\235\204\357\270\217\' },\n  spring: { label: \'Primavera\', icon: \'\360\237\214\270\' },\n  summer: { label: \'Estate\', icon: \'\342\230\200\357\270\217\' },\n  all_year: { label: \'Tutto l\\\'anno\', icon: \'\342\234\250\' },\n};\n\nexport function getCurrentSeason(): Season {\n  const month = new Date().getMonth(); // 0 = Jan, 9 = Oct\n  if (month >= 2 && month <= 4) return \'spring\';\n  if (month >= 5 && month <= 7) return \'summer\';\n  if (month >= 8 && month <= 10) return \'autumn\';\n  return \'winter\';\n}\n\nexport function getCurrentWeekId(d = new Date()): string {\n  const target = new Date(d.valueOf());\n  const dayNr = (d.getDay() + 6) % 7;\n  target.setDate(target.getDate() - dayNr + 3);\n  const firstThursday = target.valueOf();\n  target.setMonth(0, 1);\n  if (target.getDay() !== 4) {\n    target.setMonth(0, 1 + ((4 - target.getDay()) + 7) % 7);\n  }\n  const weekNumber = 1 + Math.ceil((firstThursday - target.valueOf()) / 604800000);\n  return `${target.getFullYear()}-W${String(weekNumber).padStart(2, \'0\')}`;\n}\n\nconst MONTH_NAMES_IT = [\n  \'Gennaio\', \'Febbraio\', \'Marzo\', \'Aprile\', \'Maggio\', \'Giugno\',\n  \'Luglio\', \'Agosto\', \'Settembre\', \'Ottobre\', \'Novembre\', \'Dicembre\'\n];\n\nconst MONTH_SHORT_IT = [\n  \'Gen\', \'Feb\', \'Mar\', \'Apr\', \'Mag\', \'Giu\',\n  \'Lug\', \'Ago\', \'Set\', \'Ott\', \'Nov\', \'Dic\'\n];\n\nexport function getMondayOfIsoWeek(weekId: string): Date {\n  const [yearStr, weekStr] = weekId.split(\'-W\');\n  const year = parseInt(yearStr, 10);\n  const week = parseInt(weekStr, 10);\n\n  // Jan 4th is always in ISO week 1\n  const jan4 = new Date(year, 0, 4);\n  const dayOfWeek = (jan4.getDay() + 6) % 7; // 0 = Mon\n  const mondayWeek1 = new Date(year, 0, 4 - dayOfWeek);\n  \n  const targetMonday = new Date(mondayWeek1.getTime() + (week - 1) * 7 * 86400000);\n  targetMonday.setHours(0, 0, 0, 0);\n  return targetMonday;\n}\n\nexport function getWeekRangeDisplay(weekId: string): { label: string; shortLabel: string; isCurrent: boolean } {\n  const monday = getMondayOfIsoWeek(weekId);\n  const sunday = new Date(monday.getTime() + 6 * 86400000);\n  const currentWeek = getCurrentWeekId();\n\n  const startDay = monday.getDate();\n  const endDay = sunday.getDate();\n  const startMonth = monday.getMonth();\n  const endMonth = sunday.getMonth();\n  const startYear = monday.getFullYear();\n  const endYear = sunday.getFullYear();\n\n  let label = \'\';\n  let shortLabel = \'\';\n\n  if (startMonth === endMonth && startYear === endYear) {\n    label = `${startDay} \342\200\223 ${endDay} ${MONTH_NAMES_IT[startMonth]} ${startYear}`;\n    shortLabel = `${startDay}\342\200\223${endDay} ${MONTH_SHORT_IT[startMonth]}`;\n  } else if (startYear === endYear) {\n    label = `${startDay} ${MONTH_SHORT_IT[startMonth]} \342\200\223 ${endDay} ${MONTH_NAMES_IT[endMonth]} ${startYear}`;\n    shortLabel = `${startDay} ${MONTH_SHORT_IT[startMonth]} \342\200\223 ${endDay} ${MONTH_SHORT_IT[endMonth]}`;\n  } else {\n    label = `${startDay} ${MONTH_SHORT_IT[startMonth]} ${startYear} \342\200\223 ${endDay} ${MONTH_SHORT_IT[endMonth]} ${endYear}`;\n    shortLabel = `${startDay} ${MONTH_SHORT_IT[startMonth]} \342\200\223 ${endDay} ${MONTH_SHORT_IT[endMonth]}`;\n  }\n\n  return {\n    label,\n    shortLabel,\n    isCurrent: weekId === currentWeek,\n  };\n}\n\nexport function getWeekDayDetails(weekId: string): Record<string, { dateNum: number; monthName: string; formattedDate: string; isToday: boolean }> {\n  const monday = getMondayOfIsoWeek(weekId);\n  const keys = [\'lun\', \'mar\', \'mer\', \'gio\', \'ven\', \'sab\', \'dom\'];\n  const today = new Date();\n  today.setHours(0, 0, 0, 0);\n\n  const result: Record<string, { dateNum: number; monthName: string; formattedDate: string; isToday: boolean }> = {};\n\n  keys.forEach((key, index) => {\n    const d = new Date(monday.getTime() + index * 86400000);\n    const isToday = d.getTime() === today.getTime();\n    result[key] = {\n      dateNum: d.getDate(),\n      monthName: MONTH_NAMES_IT[d.getMonth()],\n      formattedDate: `${d.getDate()} ${MONTH_NAMES_IT[d.getMonth()]}`,\n      isToday,\n    };\n  });\n\n  return result;\n}\n\nexport function normalizeMealSlot(slot: MealSlot | undefined, members: Person[]): MealGroup[] {\n  if (!slot) return [];\n\n  // Default fallback if members list is empty\n  const activeMembers = members && members.length > 0 ? members : [\n    { id: \'daniele\', name: \'Daniele\', avatar: \'\360\237\221\250\342\200\215\360\237\215\263\' },\n    { id: \'partner\', name: \'Partner\', avatar: \'\360\237\221\251\342\200\215\360\237\214\276\' },\n  ];\n  const allMemberIds = activeMembers.map((m) => m.id);\n\n  // If already has groups defined, ensure members are preserved\n  if (slot.groups && slot.groups.length > 0) {\n    return slot.groups;\n  }\n\n  // 1 PERSON CASE:\n  if (activeMembers.length === 1) {\n    const dishes = (slot.togetherDishes && slot.togetherDishes.length > 0)\n      ? slot.togetherDishes\n      : ((slot.danieleDishes && slot.danieleDishes.length > 0)\n          ? slot.danieleDishes\n          : (slot.partnerDishes || []));\n    return [\n      {\n        id: `grp_${activeMembers[0].id}`,\n        memberIds: [activeMembers[0].id],\n        dishes: [...dishes],\n        notes: slot.notes,\n      },\n    ];\n  }\n\n  // 2+ PERSON CASE:\n  if (slot.type === \'together\' || (!slot.type && (!slot.danieleDishes?.length && !slot.partnerDishes?.length))) {\n    return [\n      {\n        id: \'grp_all\',\n        memberIds: [...allMemberIds],\n        dishes: slot.togetherDishes ? [...slot.togetherDishes] : [],\n        notes: slot.notes,"
    num_lines: 684
