crostoni\' }],\n    danieleDishes: [],\n    partnerDishes: [],\n  };\n\n  return menu;\n}\n\nexport function createInitialHousehold(code = \'CASA01\'): Household {\n  const currentWeek = getCurrentWeekId();\n  const sampleWeek = createSampleWeekMenu(currentWeek);\n\n  return {\n    code,\n    name: \'Casa Nostra\',\n    users: {\n      daniele: { name: \'Daniele\', avatar: \'\360\237\221\250\342\200\215\360\237\215\263\' },\n      partner: { name: \'Partner\', avatar: \'\360\237\221\251\342\200\215\360\237\214\276\' },\n    },\n    activeWeekId: currentWeek,\n    menus: {\n      [currentWeek]: sampleWeek,\n    },\n    shoppingList: [\n      {\n        id: \'sp_1\',\n        name: \'Zucca Mantovana\',\n        category: \'ortofrutta\',\n        assignee: \'together\',\n        dishName: \'Risotto alla Zucca\',\n        dayKey: \'mar\',\n        isDone: false,\n        createdAt: new Date().toISOString(),\n      },\n      {\n        id: \'sp_2\',\n        name: \'Funghi porcini\',\n        category: \'ortofrutta\',\n        assignee: \'together\',\n        dishName: \'Vellutata di Funghi\',\n        dayKey: \'mer\',\n        isDone: false,\n        createdAt: new Date().toISOString(),\n      },\n      {\n        id: \'sp_3\',\n        name: \'Pomodorini ciliegino\',\n        category: \'ortofrutta\',\n        assignee: \'together\',\n        dishName: \'Pasta al Pesto\',\n        dayKey: \'lun\',\n        isDone: true,\n        checkedBy: \'Daniele\',\n        checkedAt: new Date().toISOString(),\n        createdAt: new Date().toISOString(),\n      },\n      {\n        id: \'sp_4\',\n        name: \'Basilico fresco\',\n        category: \'ortofrutta\',\n        assignee: \'together\',\n        dishName: \'Gnocchi al Sugo\',\n        dayKey: \'gio\',\n        isDone: false,\n        createdAt: new Date().toISOString(),\n      },\n      {\n        id: \'sp_5\',\n        name: \'Rucola fresca\',\n        category: \'ortofrutta\',\n        assignee: \'partner\',\n        