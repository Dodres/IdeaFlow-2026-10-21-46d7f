        target_content: "import React, { createContext, useContext, useState, useEffect, useCallback, useMemo } from \'react\';\nimport {\n  Household,\n  ShoppingItem,\n  Recipe,\n  ColorTheme,\n  DisplayMode,\n  DayKey,\n  MealType,\n  MealSlot,\n  Dish,\n  MealSlotType,\n  Assignee,\n  SavedHouseholdInfo,\n  HouseDefinition,\n  Person,\n  MealGroup,\n} from \'../types.ts\';\nimport { createInitialHousehold, getCurrentWeekId, normalizeMealSlot } from \'../data/initialData.ts\';\n\ninterface HouseholdContextValue {\n  household: Household;\n  householdCode: string;\n  members: Person[];\n  savedHouseholds: SavedHouseholdInfo[];\n  isLoading: boolean;\n  isSyncing: boolean;\n  isConnected: boolean;\n  currentRole: string; // memberId\n  colorTheme: ColorTheme;\n  displayMode: DisplayMode;\n  activeWeekId: string;\n  setActiveWeekId: (weekId: string) => void;\n  setCurrentRole: (role: string) => void;\n  setColorTheme: (theme: ColorTheme) => void;\n  setDisplayMode: (mode: DisplayMode) => void;\n  setHouseholdCode: (code: string) => void;\n  joinHousehold: (code: string) => Promise<boolean>;\n  switchHousehold: (code: string) => Promise<boolean>;\n  removeSavedHousehold: (code: string) => void;\n  createNewHousehold: (name: string, customCode?: string, danieleName?: string, partnerName?: string) => Promise<string>;\n  updateHousehold: (updater: (prev: Household) => Household) => Promise<void>;\n  addMember: (name: string, avatar?: string) => Promise<void>;\n  updateMember: (id: string, name: string, avatar?: string) => Promise<void>;\n  removeMember: (id: string) => Promise<void>;\n  addHouseLocation: (name: string, icon?: string) => Promise<void>;\n  removeHouseLocation: (id: string) => Promise<void>;\n  setMealLocation: (weekId: string, dayKey: DayKey, mealType: MealType, location: string) => Promise<void>;\n  updateMealSlotGroups: (weekId: string, dayKey: DayKey, mealType: MealType, groups: MealGroup[], slotType?: MealSlotType) => Promise<void>;\n  setMealSlotMode: (weekId: string, dayKey: DayKey, mealType: MealType, mode: \'together\' | \'separate\' | \'custom_groups\', customGroups?: MealGroup[]) => Promise<void>;\n  addDishToGroup: (weekId: string, dayKey: DayKey, mealType: MealType, groupId: string, dish: Dish, autoAddShopping?: boolean) => Promise<void>;\n  removeDishFromGroup: (weekId: string, dayKey: DayKey, mealType: MealType, groupId: string, dishId: string) => Promise<void>;\n  toggleShoppingItem: (itemId: string, isDone?: boolean) => Promise<void>;\n  addShoppingItem: (item: {\n    name: string;\n    category?: any;\n    assignee?: Assignee;\n    dishName?: string;\n    dayKey?: DayKey;\n    targetHouse?: string;\n  }) => Promise<void>;\n  addMultipleShoppingItems: (\n    items: Array<{\n      name: string;\n      category?: any;\n      assignee?: Assignee;\n      dishName?: string;\n      dayKey?: DayKey;\n      targetHouse?: string;\n    }>\n  ) => Promise<void>;\n  deleteShoppingItem: (itemId: string) => Promise<void>;\n  clearCompletedShopping: () => Promise<void>;\n  updateMealSlot: (weekId: string, dayKey: DayKey, mealType: MealType, slot: MealSlot) => Promise<void>;\n  addDishToSlot: (\n    weekId: string,\n    dayKey: DayKey,\n    mealType: MealType,\n    target: \'together\' | \'daniele\' | \'partner\',\n    dish: Dish,\n    autoAddIngredientsToShopping?: boolean\n  ) => Promise<void>;\n  removeDishFromSlot: (\n    weekId: string,\n    dayKey: DayKey,\n    mealType: MealType,\n    target: \'together\' | \'daniele\' | \'partner\',\n    dishId: string\n  ) => Promise<void>;\n  toggleMealSlotType: (weekId: string, dayKey: DayKey, mealType: MealType) => Promise<void>;\n  saveRecipe: (recipe: Recipe) => Promise<void>;\n  recordRecipePrepared: (recipeId: string, dateStr?: string) => Promise<void>;\n}\n\nconst HouseholdContext = createContext<HouseholdContextValue | null>(null);\n\nconst CODE_STORAGE_KEY = \'menu_spesa_household_code\';\nconst SAVED_HOUSES_KEY = \'menu_spesa_saved_households_list\';\nconst ROLE_STORAGE_KEY = \'menu_spesa_user_role\';\nconst THEME_STORAGE_KEY = \'menu_spesa_color_theme\';\nconst MODE_STORAGE_KEY = \'menu_spesa_display_mode\';\n\nexport const HouseholdProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {\n  const [householdCode, setHouseholdCodeState] = useState<string>(() => {\n    return localStorage.getItem(CODE_STORAGE_KEY) || \'CASA01\';\n  });\n\n  const [savedHouseholds, setSavedHouseholds] = useState<SavedHouseholdInfo[]>(() => {\n    try {\n      const stored = localStorage.getItem(SAVED_HOUSES_KEY);\n      if (stored) return JSON.parse(stored);\n    } catch {}\n    return [{ code: \'CASA01\', name: \'Casa Nostra\' }];\n  });\n\n  const [currentRole, setCurrentRoleState] = useState<string>(() => {\n    return localStorage.getItem(ROLE_STORAGE_KEY) || \'daniele\';\n  });\n\n  const [colorTheme, setColorThemeState] = useState<ColorTheme>(() => {\n    return (localStorage.getItem(THEME_STORAGE_KEY) as ColorTheme) || \'salvia\';\n  });\n\n  const [displayMode, setDisplayModeState] = useState<DisplayMode>(() => {\n    return (localStorage.getItem(MODE_STORAGE_KEY) as DisplayMode) || \'auto\';\n  });\n\n  const [activeWeekId, setActiveWeekId] = useState<string>(getCurrentWeekId());\n  const [household, setHousehold] = useState<Household>(() => createInitialHousehold(householdCode));\n  const [isLoading, setIsLoading] = useState<boolean>(true);\n  const [isSyncing, setIsSyncing] = useState<boolean>(false);\n  const [isConnected, setIsConnected] = useState<boolean>(false);\n\n  // Dynamic members list (with fallback to users if members array is empty)\n  const members = useMemo<Person[]>(() => {\n    if (household.members && household.members.length > 0) {\n      return household.members;\n    }\n    if (household.users) {\n      return [\n        { id: \'daniele\', name: household.users.daniele?.name || \'Daniele\', avatar: household.users.daniele?.avatar || \'\360\237\221\250\342\200\215\360\237\215\263\' },\n        { id: \'partner\', name: household.users.partner?.name || \'Partner\', avatar: household.users.partner?.avatar || \'\360\237\221\251\342\200\215\360\237\214\276\' },\n      ];\n    }\n    return [{ id: \'daniele\', name: \'Daniele\', avatar: \'\360\237\221\250\342\200\215\360\237\215\263\' }];\n  }, [household.members, household.users]);\n\n  // Apply theme to HTML tag\n  useEffect(() => {\n    const root = document.documentElement;\n    root.setAttribute(\'data-theme\', colorTheme);\n\n    const isDark =\n      displayMode === \'dark\' ||\n      (displayMode === \'auto\' && window.matchMedia(\'(prefers-color-scheme: dark)\').matches);\n\n    if (isDark) {\n      root.classList.add(\'dark\');\n    } else {\n      root.classList.remove(\'dark\');\n    }\n  }, [colorTheme, displayMode]);\n\n  // Handle system dark mode changes if mode === \'auto\'\n  useEffect(() => {\n    if (displayMode !== \'auto\') return;\n    const media = window.matchMedia(\'(prefers-color-scheme: dark)\');\n    const listener = (e: MediaQueryListEvent) => {\n      if (e.matches) {\n        document.documentElement.classList.add(\'dark\');\n      } else {\n        document.documentElement.classList.remove(\'dark\');\n      }\n    };\n    media.addEventListener(\'change\', listener);\n    return () => media.removeEventListener(\'change\', listener);\n  }, [displayMode]);\n\n  const setCurrentRole = (role: string) => {\n    setCurrentRoleState(role);\n    localStorage.setItem(ROLE_STORAGE_KEY, role);\n  };\n\n  const setColorTheme = (theme: ColorTheme) => {\n    setColorThemeState(theme);\n    localStorage.setItem(THEME_STORAGE_KEY, theme);\n  };\n\n  const setDisplayMode = (mode: DisplayMode) => {\n    setDisplayModeState(mode);\n    localStorage.setItem(MODE_STORAGE_KEY, mode);\n  };\n\n  const setHouseholdCode = (code: string) => {\n    const upper = code.trim().toUpperCase();\n    setHouseholdCodeState(upper);\n    localStorage.setItem(CODE_STORAGE_KEY, upper);\n  };\n\n  const registerSavedHousehold = (code: string, name: string) => {\n    setSavedHouseholds((prev) => {\n      const filtered = prev.filter((h) => h.code !== code);\n      const updated = [{ code, name }, ...filtered];\n      localStorage.setItem(SAVED_HOUSES_KEY, JSON.stringify(updated));\n      return updated;\n    });\n  };\n\n  const removeSavedHousehold = (code: string) => {\n    setSavedHouseholds((prev) => {\n      const updated = prev.filter((h) => h.code !== code);\n      localStorage.setItem(SAVED_HOUSES_KEY, JSON.stringify(updated));\n      return updated;\n    });\n  };\n\n  // Fetch initial household data\n  const fetchHousehold = useCallback(async (code: string) => {\n    try {\n      setIsLoading(true);\n      const res = await fetch(`/api/households/${code}`);\n      if (res.ok) {\n        const data = await res.json();\n        if (!data.houses || data.houses.length === 0) {\n          data.houses = [\n            { id: \'casa_daniele\', name: \'Casa Daniele\', icon: \'\360\237\217\240\' },\n            { id: \'casa_partner\', name: \'Casa Partner\', icon: \'\360\237\217\241\' },\n          ];\n        }\n        if (!data.members || data.members.length === 0) {\n          if (data.users) {\n            data.members = [\n              { id: \'daniele\', name: data.users.daniele?.name || \'Daniele\', avatar: data.users.daniele?.avatar || \'\360\237\221\250\342\200\215\360\237\215\263\' },\n              { id: \'partner\', name: data.users.partner?.name || \'Partner\', avatar: data.users.partner?.avatar || \'\360\237\221\251\342\200\215\360\237\214\276\' },\n            ];\n          } else {\n            data.members = [{ id: \'daniele\', name: \'Daniele\', avatar: \'\360\237\221\250\342\200\215\360\237\215\263\' }];\n          }\n        }\n        setHousehold(data);\n        registerSavedHousehold(data.code, data.name || data.code);\n      } else if (res.status === 404) {\n        console.warn(`Household ${code} not found, initializing...`);\n      }\n    } catch (err) {\n      console.error(\'Fetch household error:\', err);\n    } finally {\n      setIsLoading(false);\n    }\n  }, []);\n\n  useEffect(() => {\n    fetchHousehold(householdCode);\n  }, [householdCode, fetchHousehold]);\n\n  // Real-time SSE connection\n  useEffect(() => {\n    let eventSource: EventSource | null = null;\n    let reconnectTimeout: any = null;\n\n    const connectSSE = () => {\n      try {\n        eventSource = new EventSource(`/api/households/${householdCode}/events`);\n\n        eventSource.onopen = () => {\n          setIsConnected(true);\n        };\n\n        eventSource.addEventListener(\'update\', (e: MessageEvent) => {\n          try {\n            const payload = JSON.parse(e.data);\n            if (payload && payload.household) {\n              setHousehold(payload.household);\n              registerSavedHousehold(payload.household.code, payload.household.name);\n            }\n          } catch (err) {\n            console.error(\'SSE JSON error:\', err);\n          }\n        });\n\n        eventSource.onerror = () => {\n          setIsConnected(false);\n          eventSource?.close();\n          reconnectTimeout = setTimeout(connectSSE, 3000);\n        };\n      } catch (err) {\n        setIsConnected(false);\n      }\n    };\n\n    connectSSE();\n\n    return () => {\n      if (eventSource) eventSource.close();\n      if (reconnectTimeout) clearTimeout(reconnectTimeout);\n    };\n  }, [householdCode]);\n\n  const saveHouseholdState = async (updated: Household) => {\n    setHousehold(updated);\n    setIsSyncing(true);\n    try {\n      await fetch(`/api/households/${householdCode}`, {\n        method: \'PUT\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify(updated),\n      });\n      registerSavedHousehold(updated.code, updated.name);\n    } catch (err) {\n      console.error(\'Failed to sync household:\', err);\n    } finally {\n      setIsSyncing(false);\n    }\n  };\n\n  const updateHousehold = async (updater: (prev: Household) => Household) => {\n    const next = updater(household);\n    await saveHouseholdState(next);\n  };\n\n  // Switch between saved households in 1 click\n  const switchHousehold = async (code: string): Promise<boolean> => {\n    const upper = code.trim().toUpperCase();\n    try {\n      setIsLoading(true);\n      const res = await fetch(`/api/households/${upper}`);\n      if (res.ok) {\n        const data = await res.json();\n        setHousehold(data);\n        setHouseholdCode(upper);\n        registerSavedHousehold(data.code, data.name);\n        return true;\n      }\n      return false;\n    } catch (err) {\n      return false;\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const joinHousehold = async (code: string): Promise<boolean> => {\n    return switchHousehold(code);\n  };\n\n  const createNewHousehold = async (\n    name: string,\n    customCode?: string,\n    danieleName?: string,\n    partnerName?: string\n  ): Promise<string> => {\n    try {\n      setIsLoading(true);\n      const res = await fetch(\'/api/households\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ name, customCode, danieleName, partnerName }),\n      });\n      if (res.ok) {\n        const data = await res.json();\n        setHousehold(data);\n        setHouseholdCode(data.code);\n        registerSavedHousehold(data.code, data.name);\n        return data.code;\n      }\n      throw new Error(\'Errore creazione spazio\');\n    } finally {\n      setIsLoading(false);\n    }\n  };"
        replacement_content: "import React, { createContext, useContext, useState, useEffect, useCallback, useMemo } from \'react\';\nimport {\n  Household,\n  ShoppingItem,\n  Recipe,\n  ColorTheme,\n  DisplayMode,\n  DayKey,\n  MealType,\n  MealSlot,\n  Dish,\n  MealSlotType,\n  Assignee,\n  SavedHouseholdInfo,\n  HouseDefinition,\n  Person,\n  MealGroup,\n  AppUser,\n} from \'../types.ts\';\nimport { createInitialHousehold, getCurrentWeekId, normalizeMealSlot } from \'../data/initialData.ts\';\nimport { auth, db, signInWithGoogle, logOut, onAuthStateChanged } from \'../firebase.ts\';\nimport {\n  doc,\n  getDoc,\n  setDoc,\n  updateDoc,\n  onSnapshot,\n  arrayUnion,\n} from \'firebase/firestore\';\n\ninterface HouseholdContextValue {\n  household: Household;\n  householdCode: string;\n  members: Person[];\n  savedHouseholds: SavedHouseholdInfo[];\n  isLoading: boolean;\n  isSyncing: boolean;\n  isConnected: boolean;\n  currentRole: string; // memberId\n  colorTheme: ColorTheme;\n  displayMode: DisplayMode;\n  activeWeekId: string;\n  user: AppUser | null;\n  isAuthLoading: boolean;\n  isShareModalOpen: boolean;\n  setIsShareModalOpen: (open: boolean) => void;\n  loginWithGoogle: () => Promise<void>;\n  logout: () => Promise<void>;\n  setActiveWeekId: (weekId: string) => void;\n  setCurrentRole: (role: string) => void;\n  setColorTheme: (theme: ColorTheme) => void;\n  setDisplayMode: (mode: DisplayMode) => void;\n  setHouseholdCode: (code: string) => void;\n  joinHousehold: (code: string) => Promise<boolean>;\n  switchHousehold: (code: string) => Promise<boolean>;\n  removeSavedHousehold: (code: string) => void;\n  createNewHousehold: (name: string, customCode?: string, danieleName?: string, partnerName?: string) => Promise<string>;\n  updateHousehold: (updater: (prev: Household) => Household) => Promise<void>;\n  addMember: (name: string, avatar?: string) => Promise<void>;\n  updateMember: (id: string, name: string, avatar?: string) => Promise<void>;\n  removeMember: (id: string) => Promise<void>;\n  addHouseLocation: (name: string, icon?: string) => Promise<void>;\n  removeHouseLocation: (id: string) => Promise<void>;\n  setMealLocation: (weekId: string, dayKey: DayKey, mealType: MealType, location: string) => Promise<void>;\n  updateMealSlotGroups: (weekId: string, dayKey: DayKey, mealType: MealType, groups: MealGroup[], slotType?: MealSlotType) => Promise<void>;\n  setMealSlotMode: (weekId: string, dayKey: DayKey, mealType: MealType, mode: \'together\' | \'separate\' | \'custom_groups\', customGroups?: MealGroup[]) => Promise<void>;\n  addDishToGroup: (weekId: string, dayKey: DayKey, mealType: MealType, groupId: string, dish: Dish, autoAddShopping?: boolean) => Promise<void>;\n  removeDishFromGroup: (weekId: string, dayKey: DayKey, mealType: MealType, groupId: string, dishId: string) => Promise<void>;\n  toggleShoppingItem: (itemId: string, isDone?: boolean) => Promise<void>;\n  addShoppingItem: (item: {\n    name: string;\n    category?: any;\n    assignee?: Assignee;\n    dishName?: string;\n    dayKey?: DayKey;\n    targetHouse?: string;\n  }) => Promise<void>;\n  addMultipleShoppingItems: (\n    items: Array<{\n      name: string;\n      category?: any;\n      assignee?: Assignee;\n      dishName?: string;\n      dayKey?: DayKey;\n      targetHouse?: string;\n    }>\n  ) => Promise<void>;\n  deleteShoppingItem: (itemId: string) => Promise<void>;\n  clearCompletedShopping: () => Promise<void>;\n  updateMealSlot: (weekId: string, dayKey: DayKey, mealType: MealType, slot: MealSlot) => Promise<void>;\n  addDishToSlot: (\n    weekId: string,\n    dayKey: DayKey,\n    mealType: MealType,\n    target: \'together\' | \'daniele\' | \'partner\',\n    dish: Dish,\n    autoAddIngredientsToShopping?: boolean\n  ) => Promise<void>;\n  removeDishFromSlot: (\n    weekId: string,\n    dayKey: DayKey,\n    mealType: MealType,\n    target: \'together\' | \'daniele\' | \'partner\',\n    dishId: string\n  ) => Promise<void>;\n  toggleMealSlotType: (weekId: string, dayKey: DayKey, mealType: MealType) => Promise<void>;\n  saveRecipe: (recipe: Recipe) => Promise<void>;\n  recordRecipePrepared: (recipeId: string, dateStr?: string) => Promise<void>;\n}\n\nconst HouseholdContext = createContext<HouseholdContextValue | null>(null);\n\nconst CODE_STORAGE_KEY = \'menu_spesa_household_code\';\nconst SAVED_HOUSES_KEY = \'menu_spesa_saved_households_list\';\nconst ROLE_STORAGE_KEY = \'menu_spesa_user_role\';\nconst THEME_STORAGE_KEY = \'menu_spesa_color_theme\';\nconst MODE_STORAGE_KEY = \'menu_spesa_display_mode\';\n\nfunction cleanForFirestore(obj: any): any {\n  if (obj === undefined) return null;\n  if (obj === null || typeof obj !== \'object\') return obj;\n  if (Array.isArray(obj)) {\n    return obj.map(cleanForFirestore);\n  }\n  const result: Record<string, any> = {};\n  for (const [key, value] of Object.entries(obj)) {\n    if (value !== undefined) {\n      result[key] = cleanForFirestore(value);\n    }\n  }\n  return result;\n}\n\nexport const HouseholdProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {\n  const [householdCode, setHouseholdCodeState] = useState<string>(() => {\n    return localStorage.getItem(CODE_STORAGE_KEY) || \'CASA01\';\n  });\n\n  const [savedHouseholds, setSavedHouseholds] = useState<SavedHouseholdInfo[]>(() => {\n    try {\n      const stored = localStorage.getItem(SAVED_HOUSES_KEY);\n      if (stored) return JSON.parse(stored);\n    } catch {}\n    return [{ code: \'CASA01\', name: \'Casa Nostra\' }];\n  });\n\n  const [currentRole, setCurrentRoleState] = useState<string>(() => {\n    return localStorage.getItem(ROLE_STORAGE_KEY) || \'daniele\';\n  });\n\n  const [colorTheme, setColorThemeState] = useState<ColorTheme>(() => {\n    return (localStorage.getItem(THEME_STORAGE_KEY) as ColorTheme) || \'salvia\';\n  });\n\n  const [displayMode, setDisplayModeState] = useState<DisplayMode>(() => {\n    return (localStorage.getItem(MODE_STORAGE_KEY) as DisplayMode) || \'auto\';\n  });\n\n  const [activeWeekId, setActiveWeekId] = useState<string>(getCurrentWeekId());\n  const [household, setHousehold] = useState<Household>(() => createInitialHousehold(householdCode));\n  const [isLoading, setIsLoading] = useState<boolean>(true);\n  const [isSyncing, setIsSyncing] = useState<boolean>(false);\n  const [isConnected, setIsConnected] = useState<boolean>(true);\n  const [user, setUser] = useState<AppUser | null>(null);\n  const [isAuthLoading, setIsAuthLoading] = useState<boolean>(true);\n  const [isShareModalOpen, setIsShareModalOpen] = useState<boolean>(false);\n\n  // Dynamic members list (with fallback to users if members array is empty)\n  const members = useMemo<Person[]>(() => {\n    if (household.members && household.members.length > 0) {\n      return household.members;\n    }\n    if (household.users) {\n      return [\n        { id: \'daniele\', name: household.users.daniele?.name || \'Daniele\', avatar: household.users.daniele?.avatar || \'\360\237\221\250\342\200\215\360\237\215\263\' },\n        { id: \'partner\', name: household.users.partner?.name || \'Partner\', avatar: household.users.partner?.avatar || \'\360\237\221\251\342\200\215\360\237\214\276\' },\n      ];\n    }\n    return [{ id: \'daniele\', name: \'Daniele\', avatar: \'\360\237\221\250\342\200\215\360\237\215\263\' }];\n  }, [household.members, household.users]);\n\n  // Apply theme to HTML tag\n  useEffect(() => {\n    const root = document.documentElement;\n    root.setAttribute(\'data-theme\', colorTheme);\n\n    const isDark =\n      displayMode === \'dark\' ||\n      (displayMode === \'auto\' && window.matchMedia(\'(prefers-color-scheme: dark)\').matches);\n\n    if (isDark) {\n      root.classList.add(\'dark\');\n    } else {\n      root.classList.remove(\'dark\');\n    }\n  }, [colorTheme, displayMode]);\n\n  // Handle system dark mode changes if mode === \'auto\'\n  useEffect(() => {\n    if (displayMode !== \'auto\') return;\n    const media = window.matchMedia(\'(prefers-color-scheme: dark)\');\n    const listener = (e: MediaQueryListEvent) => {\n      if (e.matches) {\n        document.documentElement.classList.add(\'dark\');\n      } else {\n        document.documentElement.classList.remove(\'dark\');\n      }\n    };\n    media.addEventListener(\'change\', listener);\n    return () => media.removeEventListener(\'change\', listener);\n  }, [displayMode]);\n\n  // Listen to Firebase Auth state\n  useEffect(() => {\n    const unsub = onAuthStateChanged(auth, async (fbUser) => {\n      setIsAuthLoading(false);\n      if (fbUser) {\n        const appUser: AppUser = {\n          uid: fbUser.uid,\n          email: fbUser.email,\n          displayName: fbUser.displayName || fbUser.email?.split(\'@\')[0] || \'Utente\',\n          photoURL: fbUser.photoURL,\n        };\n        setUser(appUser);\n\n        // Sync or register user document in Firestore\n        try {\n          const userDocRef = doc(db, \'users\', fbUser.uid);\n          const userSnap = await getDoc(userDocRef);\n          const currentCodes = savedHouseholds.map((h) => h.code);\n          if (!currentCodes.includes(householdCode)) {\n            currentCodes.push(householdCode);\n          }\n\n          if (!userSnap.exists()) {\n            await setDoc(userDocRef, {\n              uid: fbUser.uid,\n              email: fbUser.email,\n              displayName: appUser.displayName,\n              photoURL: fbUser.photoURL,\n              households: currentCodes,\n              createdAt: new Date().toISOString(),\n              updatedAt: new Date().toISOString(),\n            });\n          } else {\n            const udata = userSnap.data();\n            const remoteHouses: string[] = udata?.households || [];\n            const merged = Array.from(new Set([...remoteHouses, ...currentCodes]));\n            if (merged.length > remoteHouses.length) {\n              await updateDoc(userDocRef, { households: merged });\n            }\n            // Add all user\'s houses to savedHouseholds\n            for (const code of merged) {\n              registerSavedHousehold(code, code);\n            }\n          }\n        } catch (err) {\n          console.warn(\'Firebase user sync:\', err);\n        }\n      } else {\n        setUser(null);\n      }\n    });\n\n    return () => unsub();\n  }, [householdCode]);\n\n  const loginWithGoogle = async () => {\n    try {\n      await signInWithGoogle();\n    } catch (err) {\n      console.error(\'Google Sign-In error:\', err);\n      throw err;\n    }\n  };\n\n  const logout = async () => {\n    try {\n      await logOut();\n      setUser(null);\n    } catch (err) {\n      console.error(\'Logout error:\', err);\n    }\n  };\n\n  const setCurrentRole = (role: string) => {\n    setCurrentRoleState(role);\n    localStorage.setItem(ROLE_STORAGE_KEY, role);\n  };\n\n  const setColorTheme = (theme: ColorTheme) => {\n    setColorThemeState(theme);\n    localStorage.setItem(THEME_STORAGE_KEY, theme);\n  };\n\n  const setDisplayMode = (mode: DisplayMode) => {\n    setDisplayModeState(mode);\n    localStorage.setItem(MODE_STORAGE_KEY, mode);\n  };\n\n  const setHouseholdCode = (code: string) => {\n    const upper = code.trim().toUpperCase();\n    setHouseholdCodeState(upper);\n    localStorage.setItem(CODE_STORAGE_KEY, upper);\n  };\n\n  const registerSavedHousehold = (code: string, name: string) => {\n    setSavedHouseholds((prev) => {\n      const filtered = prev.filter((h) => h.code !== code);\n      const updated = [{ code, name }, ...filtered];\n      localStorage.setItem(SAVED_HOUSES_KEY, JSON.stringify(updated));\n      return updated;\n    });\n  };\n\n  const removeSavedHousehold = (code: string) => {\n    setSavedHouseholds((prev) => {\n      const updated = prev.filter((h) => h.code !== code);\n      localStorage.setItem(SAVED_HOUSES_KEY, JSON.stringify(updated));\n      return updated;\n    });\n  };\n\n  // Fetch initial household data from Firestore / API\n  const fetchHousehold = useCallback(async (code: string) => {\n    try {\n      setIsLoading(true);\n      let loadedData: Household | null = null;\n\n      // Try Firestore first\n      try {\n        const snap = await getDoc(doc(db, \'households\', code));\n        if (snap.exists()) {\n          loadedData = snap.data() as Household;\n        }\n      } catch (e) {\n        console.warn(\'Firestore fetch note:\', e);\n      }\n\n      // Fallback to local server API\n      if (!loadedData) {\n        const res = await fetch(`/api/households/${code}`);\n        if (res.ok) {\n          loadedData = await res.json();\n        }\n      }\n\n      if (loadedData) {\n        if (!loadedData.houses || loadedData.houses.length === 0) {\n          loadedData.houses = [\n            { id: \'casa_daniele\', name: \'Casa Daniele\', icon: \'\360\237\217\240\' },\n            { id: \'casa_partner\', name: \'Casa Partner\', icon: \'\360\237\217\241\' },\n          ];\n        }\n        if (!loadedData.members || loadedData.members.length === 0) {\n          if (loadedData.users) {\n            loadedData.members = [\n              { id: \'daniele\', name: loadedData.users.daniele?.name || \'Daniele\', avatar: loadedData.users.daniele?.avatar || \'\360\237\221\250\342\200\215\360\237\215\263\' },\n              { id: \'partner\', name: loadedData.users.partner?.name || \'Partner\', avatar: loadedData.users.partner?.avatar || \'\360\237\221\251\342\200\215\360\237\214\276\' },\n            ];\n          } else {\n            loadedData.members = [{ id: \'daniele\', name: \'Daniele\', avatar: \'\360\237\221\250\342\200\215\360\237\215\263\' }];\n          }\n        }\n        setHousehold(loadedData);\n        registerSavedHousehold(loadedData.code, loadedData.name || loadedData.code);\n      }\n    } catch (err) {\n      console.error(\'Fetch household error:\', err);\n    } finally {\n      setIsLoading(false);\n    }\n  }, []);\n\n  useEffect(() => {\n    fetchHousehold(householdCode);\n  }, [householdCode, fetchHousehold]);\n\n  // Real-time Firestore sync & SSE fallback\n  useEffect(() => {\n    // 1. Real-time listener via Firestore\n    let unsubFirestore: (() => void) | null = null;\n    try {\n      unsubFirestore = onSnapshot(doc(db, \'households\', householdCode), (docSnap) => {\n        if (docSnap.exists()) {\n          const data = docSnap.data() as Household;\n          setHousehold((prev) => ({\n            ...prev,\n            ...data,\n          }));\n          registerSavedHousehold(data.code, data.name || data.code);\n          setIsConnected(true);\n        }\n      }, () => {\n        // Fallback silently if offline or rules apply\n      });\n    } catch {}\n\n    // 2. Real-time SSE connection with server\n    let eventSource: EventSource | null = null;\n    let reconnectTimeout: any = null;\n\n    const connectSSE = () => {\n      try {\n        eventSource = new EventSource(`/api/households/${householdCode}/events`);\n        eventSource.onopen = () => setIsConnected(true);\n\n        eventSource.addEventListener(\'update\', (e: MessageEvent) => {\n          try {\n            const payload = JSON.parse(e.data);\n            if (payload && payload.household) {\n              setHousehold(payload.household);\n              registerSavedHousehold(payload.household.code, payload.household.name);\n            }\n          } catch {}\n        });\n\n        eventSource.onerror = () => {\n          eventSource?.close();\n          reconnectTimeout = setTimeout(connectSSE, 4000);\n        };\n      } catch {}\n    };\n\n    connectSSE();\n\n    return () => {\n      if (unsubFirestore) unsubFirestore();\n      if (eventSource) eventSource.close();\n      if (reconnectTimeout) clearTimeout(reconnectTimeout);\n    };\n  }, [householdCode]);\n\n  const saveHouseholdState = async (updated: Household) => {\n    setHousehold(updated);\n    setIsSyncing(true);\n\n    // Save to Firestore\n    try {\n      const clean = cleanForFirestore(updated);\n      await setDoc(doc(db, \'households\', householdCode), clean, { merge: true });\n    } catch (err) {\n      console.warn(\'Firestore sync note:\', err);\n    }\n\n    // Save to server\n    try {\n      await fetch(`/api/households/${householdCode}`, {\n        method: \'PUT\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify(updated),\n      });\n      registerSavedHousehold(updated.code, updated.name);\n    } catch (err) {\n      console.error(\'Failed to sync household:\', err);\n    } finally {\n      setIsSyncing(false);\n    }\n  };\n\n  const updateHousehold = async (updater: (prev: Household) => Household) => {\n    const next = updater(household);\n    await saveHouseholdState(next);\n  };\n\n  // Switch between saved households in 1 click\n  const switchHousehold = async (code: string): Promise<boolean> => {\n    const upper = code.trim().toUpperCase();\n    try {\n      setIsLoading(true);\n      let data: Household | null = null;\n\n      try {\n        const snap = await getDoc(doc(db, \'households\', upper));\n        if (snap.exists()) {\n          data = snap.data() as Household;\n        }\n      } catch {}\n\n      if (!data) {\n        const res = await fetch(`/api/households/${upper}`);\n        if (res.ok) {\n          data = await res.json();\n        }\n      }\n\n      if (data) {\n        setHousehold(data);\n        setHouseholdCode(upper);\n        registerSavedHousehold(data.code, data.name);\n        return true;\n      }\n      return false;\n    } catch (err) {\n      return false;\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const joinHousehold = async (code: string): Promise<boolean> => {\n    const upper = code.trim().toUpperCase();\n    try {\n      setIsLoading(true);\n      let loadedData: Household | null = null;\n\n      try {\n        const snap = await getDoc(doc(db, \'households\', upper));\n        if (snap.exists()) {\n          loadedData = snap.data() as Household;\n        }\n      } catch {}\n\n      if (!loadedData) {\n        const res = await fetch(`/api/households/${upper}`);\n        if (res.ok) {\n          loadedData = await res.json();\n        }\n      }\n\n      if (loadedData) {\n        // If user is authenticated, attach to memberUids and user\'s profile\n        if (user) {\n          const uids = loadedData.memberUids || [];\n          if (!uids.includes(user.uid)) {\n            loadedData.memberUids = [...uids, user.uid];\n            // If user\'s name is not in members array, add them\n            const hasMember = (loadedData.members || []).some(\n              (m) => m.id === user.uid || m.name.toLowerCase() === (user.displayName || \'\').toLowerCase()\n            );\n            if (!hasMember) {\n              loadedData.members = [\n                ...(loadedData.members || []),\n                {\n                  id: user.uid,\n                  name: user.displayName || \'Nuovo Membro\',\n                  avatar: \'\360\237\221\213\',\n                },\n              ];\n            }\n            // Save in Firestore\n            try {\n              await setDoc(doc(db, \'households\', upper), cleanForFirestore(loadedData), { merge: true });\n            } catch {}\n          }\n\n          // Link to user document\n          try {\n            await updateDoc(doc(db, \'users\', user.uid), {\n              households: arrayUnion(upper),\n            });\n          } catch {}\n        }\n\n        setHousehold(loadedData);\n        setHouseholdCode(upper);\n        registerSavedHousehold(loadedData.code, loadedData.name || loadedData.code);\n        return true;\n      }\n      return false;\n    } catch {\n      return false;\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const createNewHousehold = async (\n    name: string,\n    customCode?: string,\n    danieleName?: string,\n    partnerName?: string\n  ): Promise<string> => {\n    try {\n      setIsLoading(true);\n      const chars = \'ABCDEFGHJKLMNPQRSTUVWXYZ23456789\';\n      let autoCode = \'\';\n      for (let i = 0; i < 6; i++) {\n        autoCode += chars.charAt(Math.floor(Math.random() * chars.length));\n      }\n      const code = (customCode ? String(customCode).trim().toUpperCase() : autoCode).slice(0, 10);\n      const newHh = createInitialHousehold(code);\n      newHh.name = name;\n\n      if (user) {\n        newHh.ownerUid = user.uid;\n        newHh.memberUids = [user.uid];\n        newHh.members = [\n          {\n            id: user.uid,\n            name: user.displayName || \'Io\',\n            avatar: \'\360\237\221\221\',\n          },\n        ];\n      } else if (danieleName && newHh.users) {\n        newHh.users.daniele.name = danieleName;\n      }\n\n      // Save to Firestore\n      try {\n        await setDoc(doc(db, \'households\', code), cleanForFirestore(newHh));\n      } catch (e) {\n        console.warn(\'Firestore create note:\', e);\n      }\n\n      // Save to server\n      try {\n        await fetch(\'/api/households\', {\n          method: \'POST\',\n          headers: { \'Content-Type\': \'application/json\' },\n          body: JSON.stringify({ name, customCode: code, danieleName, partnerName }),\n        });\n      } catch {}\n\n      // Add to user profile if logged in\n      if (user) {\n        try {\n          await updateDoc(doc(db, \'users\', user.uid), {\n            households: arrayUnion(code),\n          });\n        } catch {}\n      }\n\n      setHousehold(newHh);\n      setHouseholdCode(code);\n      registerSavedHousehold(code, name);\n      return code;\n    } finally {\n      setIsLoading(false);\n    }\n  };"
