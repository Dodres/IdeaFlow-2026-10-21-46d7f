    content: "import React, { useState } from \'react\';\nimport {\n  Users,\n  Copy,\n  Check,\n  Palette,\n  Sun,\n  Moon,\n  Laptop,\n  Share2,\n  UserCheck,\n  Home,\n  PlusCircle,\n  KeyRound,\n  Sparkles,\n  Trash2,\n  MapPin,\n  Building,\n} from \'lucide-react\';\nimport { useHousehold } from \'../../context/HouseholdContext.tsx\';\nimport { ColorTheme, DisplayMode } from \'../../types.ts\';\n\nexport const SettingsView: React.FC = () => {\n  const {\n    household,\n    householdCode,\n    members,\n    savedHouseholds,\n    switchHousehold,\n    removeSavedHousehold,\n    joinHousehold,\n    createNewHousehold,\n    updateHousehold,\n    addMember,\n    updateMember,\n    removeMember,\n    addHouseLocation,\n    removeHouseLocation,\n    currentRole,\n    setCurrentRole,\n    colorTheme,\n    setColorTheme,\n    displayMode,\n    setDisplayMode,\n    isConnected,\n  } = useHousehold();\n\n  const [copiedCode, setCopiedCode] = useState(false);\n  const [copiedLink, setCopiedLink] = useState(false);\n\n  // Join form state\n  const [inputCode, setInputCode] = useState(\'\');\n  const [joinError, setJoinError] = useState<string | null>(null);\n  const [isJoining, setIsJoining] = useState(false);\n\n  // New space form state\n  const [isCreatingSpace, setIsCreatingSpace] = useState(false);\n  const [spaceName, setSpaceName] = useState(\'\');\n  const [customCode, setCustomCode] = useState(\'\');\n\n  // Add House Location state\n  const [newLocationName, setNewLocationName] = useState(\'\');\n  const [newLocationIcon, setNewLocationIcon] = useState(\'\360\237\217\240\');\n\n  // Edit user names\n  const [danieleName, setDanieleName] = useState(household.users?.daniele?.name || \'Daniele\');\n  const [partnerName, setPartnerName] = useState(household.users?.partner?.name || \'Partner\');\n  const [savedUsersNotice, setSavedUsersNotice] = useState(false);\n\n  const handleSetPresetMembers = async (count: 1 | 2 | 3 | 4) => {\n    let newMembers: any[] = [];\n    if (count === 1) {\n      newMembers = [{ id: \'daniele\', name: \'Daniele\', avatar: \'\360\237\221\250\342\200\215\360\237\215\263\' }];\n    } else if (count === 2) {\n      newMembers = [\n        { id: \'daniele\', name: \'Daniele\', avatar: \'\360\237\221\250\342\200\215\360\237\215\263\' },\n        { id: \'partner\', name: \'Partner\', avatar: \'\360\237\221\251\342\200\215\360\237\214\276\' },\n      ];\n    } else if (count === 3) {\n      newMembers = [\n        { id: \'daniele\', name: \'Daniele\', avatar: \'\360\237\221\250\342\200\215\360\237\215\263\' },\n        { id: \'partner\', name: \'Partner\', avatar: \'\360\237\221\251\342\200\215\360\237\214\276\' },\n        { id: \'luca\', name: \'Luca\', avatar: \'\360\237\221\246\' },\n      ];\n    } else {\n      newMembers = [\n        { id: \'daniele\', name: \'Daniele\', avatar: \'\360\237\221\250\342\200\215\360\237\215\263\' },\n        { id: \'partner\', name: \'Partner\', avatar: \'\360\237\221\251\342\200\215\360\237\214\276\' },\n        { id: \'luca\', name: \'Luca\', avatar: \'\360\237\221\246\' },\n        { id: \'sofia\', name: \'Sofia\', avatar: \'\360\237\221\247\' },\n      ];\n    }\n    await updateHousehold((prev) => ({\n      ...prev,\n      members: newMembers,\n    }));\n  };\n\n  const handleCopyCode = () => {\n    navigator.clipboard.writeText(household.code);\n    setCopiedCode(true);\n    setTimeout(() => setCopiedCode(false), 2000);\n  };\n\n  const handleCopyLink = () => {\n    const url = `${window.location.origin}/?code=${household.code}`;\n    navigator.clipboard.writeText(url);\n    setCopiedLink(true);\n    setTimeout(() => setCopiedLink(false), 2000);\n  };\n\n  const handleJoin = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!inputCode.trim()) return;\n    setIsJoining(true);\n    setJoinError(null);\n    const success = await joinHousehold(inputCode);\n    if (!success) {\n      setJoinError(\'Codice non valido o casa non trovata. Controlla il codice.\');\n    } else {"
