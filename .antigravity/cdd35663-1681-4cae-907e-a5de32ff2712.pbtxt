          replacement_content: "        {/* Preset Member Templates */}\n        <div className=\"space-y-2\">\n          <label className=\"text-xs font-bold uppercase tracking-wider text-app-muted block\">\n            Imposta velocemente le persone di questa casa:\n          </label>\n          <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2\">\n            <button\n              type=\"button\"\n              onClick={() => handleSetPresetMembers(1)}\n              className={`p-2.5 rounded-xl border text-left transition-all cursor-pointer ${\n                members.length === 1\n                  ? \'border-app-primary bg-app-primary-light text-app-primary font-bold shadow-xs\'\n                  : \'border-app-subtle bg-app-card hover:bg-app-muted text-app-main\'\n              }`}\n            >\n              <div className=\"text-lg\">\360\237\221\244</div>\n              <div className=\"text-xs font-bold mt-1\">1 Persona</div>\n              <div className=\"text-[10px] text-app-muted font-normal\">Nessun \"insieme/separati\"</div>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => handleSetPresetMembers(2)}\n              className={`p-2.5 rounded-xl border text-left transition-all cursor-pointer ${\n                members.length === 2\n                  ? \'border-app-primary bg-app-primary-light text-app-primary font-bold shadow-xs\'\n                  : \'border-app-subtle bg-app-card hover:bg-app-muted text-app-main\'\n              }`}\n            >\n              <div className=\"text-lg\">\360\237\221\253</div>\n              <div className=\"text-xs font-bold mt-1\">2 Persone</div>\n              <div className=\"text-[10px] text-app-muted font-normal\">Insieme o Separati</div>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => handleSetPresetMembers(3)}\n              className={`p-2.5 rounded-xl border text-left transition-all cursor-pointer ${\n                members.length === 3\n                  ? \'border-app-primary bg-app-primary-light text-app-primary font-bold shadow-xs\'\n                  : \'border-app-subtle bg-app-card hover:bg-app-muted text-app-main\'\n              }`}\n            >\n              <div className=\"text-lg\">\360\237\221\250\342\200\215\360\237\221\251\342\200\215\360\237\221\247</div>\n              <div className=\"text-xs font-bold mt-1\">3 Persone</div>\n              <div className=\"text-[10px] text-app-muted font-normal\">1 solo + 2 insieme, ecc.</div>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => handleSetPresetMembers(4)}\n              className={`p-2.5 rounded-xl border text-left transition-all cursor-pointer ${\n                members.length === 4\n                  ? \'border-app-primary bg-app-primary-light text-app-primary font-bold shadow-xs\'\n                  : \'border-app-subtle bg-app-card hover:bg-app-muted text-app-main\'\n              }`}\n            >\n              <div className=\"text-lg\">\360\237\221\250\342\200\215\360\237\221\251\342\200\215\360\237\221\247\342\200\215\360\237\221\246</div>\n              <div className=\"text-xs font-bold mt-1\">4 Persone</div>\n              <div className=\"text-[10px] text-app-muted font-normal\">A due a due, 3+1, tutti soli</div>\n            </button>\n          </div>\n        </div>\n\n        {/* Dynamic explanation banner */}\n        <div className=\"p-3.5 rounded-xl bg-app-muted/50 border border-app-subtle text-xs text-app-muted space-y-1.5\">\n          <span className=\"font-bold text-app-main block\">\n            \360\237\222\241 Come funziona il Menu in base alle persone associate:\n          </span>\n          {members.length === 1 && (\n            <p className=\"text-app-main font-medium\">\n              \360\237\221\211 <strong>1 persona associata ({members[0]?.name}):</strong> Nel menu <strong>non compare alcuna opzione \"insieme/separata\"</strong>. Pianifichi direttamente i tuoi piatti personali in modo pulito e immediato.\n            </p>\n          )}\n          {members.length === 2 && (\n            <p className=\"text-app-main font-medium\">\n              \360\237\221\211 <strong>2 persone associate ({members.map((m) => m.name).join(\' e \')}):</strong> Per ciascun pasto puoi decidere con un tap tra <strong>\360\237\221\253 Insieme</strong> (un unico piatto condiviso) oppure <strong>\360\237\224\200 Pasti Separati</strong> (colonne distinte per ciascuno).\n            </p>\n          )}\n          {members.length >= 3 && (\n            <p className=\"text-app-main font-medium\">\n              \360\237\221\211 <strong>{members.length} persone associate:</strong> Puoi creare liberamente gli insiemi che vuoi per ogni pasto! Ad esempio se sono 3: <strong>1 mangia sola e 2 mangiano insieme</strong>, oppure tutti soli o tutti insieme. Se sono 4: <strong>a due a due (2+2)</strong>, <strong>3 insieme e 1 sola</strong>, <strong>tutti soli (1+1+1+1)</strong> o <strong>tutti insieme (4)</strong>!\n            </p>\n          )}\n        </div>"
