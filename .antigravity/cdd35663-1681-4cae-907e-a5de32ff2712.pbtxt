            lines {
              text: "export function getCurrentWeekId(d = new Date()): string {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const target = new Date(d.valueOf());"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const dayNr = (d.getDay() + 6) % 7;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  target.setDate(target.getDate() - dayNr + 3);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const firstThursday = target.valueOf();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  target.setMonth(0, 1);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (target.getDay() !== 4) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    target.setMonth(0, 1 + ((4 - target.getDay()) + 7) % 7);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const weekNumber = 1 + Math.ceil((firstThursday - target.valueOf()) / 604800000);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return `${d.getFullYear()}-W${String(weekNumber).padStart(2, \'0\')}`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
