  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport {\n  ChevronLeft,\n  ChevronRight,\n  Plus,\n  Trash2,\n  Users,\n  User,\n  Sparkles,\n  ShoppingBag,\n  RotateCcw,\n  CalendarDays,\n  Calendar as CalendarIcon,\n} from \'lucide-react\';\nimport { useHousehold } from \'../../context/HouseholdContext.tsx\';\nimport { DayKey, MealType, MealSlot, Dish, Recipe } from \'../../types.ts\';\nimport {\n  getCurrentWeekId,\n  getWeekRangeDisplay,\n  getWeekDayDetails,\n} from \'../../data/initialData.ts\';\nimport { AddDishModal } from \'./AddDishModal.tsx\';\nimport { CalendarPickerModal } from \'./CalendarPickerModal.tsx\';\n\ninterface WeeklyMenuViewProps {\n  onOpenAISuggest: () => void;\n}\n\nconst DAY_KEYS: DayKey[] = [\'lun\', \'mar\', \'mer\', \'gio\', \'ven\', \'sab\', \'dom\'];\n\nconst DAY_NAMES: Record<DayKey, string> = {\n  lun: \'Luned\303\254\',\n  mar: \'Marted\303\254\',\n  mer: \'Mercoled\303\254\',\n  gio: \'Gioved\303\254\',\n  ven: \'Venerd\303\254\',\n  sab: \'Sabato\',\n  dom: \'Domenica\',\n};\n\nexport const WeeklyMenuView: React.FC<WeeklyMenuViewProps> = ({ onOpenAISuggest }) => {\n  const {\n    household,\n    activeWeekId,\n    setActiveWeekId,\n    toggleMealSlotType,\n    removeDishFromSlot,\n    addDishToSlot,\n    currentRole,\n  } = useHousehold();\n\n  const currentRealWeek = getCurrentWeekId();\n  const weekRange = getWeekRangeDisplay(activeWeekId);\n  const dayDetails = getWeekDayDetails(activeWeekId);\n\n  // Calendar picker modal state\n  const [isCalendarOpen, setIsCalendarOpen] = useState(false);\n\n  // Add dish modal state\n  const [modalState, setModalState] = useState<{\n    isOpen: boolean;\n    dayKey: DayKey;\n    dayLabel: string;\n    mealType: MealType;\n    target: \'together\' | \'daniele\' | \'partner\';\n  } | null>(null);\n\n  // Navigate weeks\n  const changeWeek = (offset: number) => {\n    const parts = activeWeekId.split(\'-W\');\n    const year = parseInt(parts[0], 10);\n    let week = parseInt(parts[1], 10) + offset;\n    let nextYear = year;\n    if (week > 52) {\n      week = 1;\n      nextYear += 1;\n    } else if (week < 1) {\n      week = 52;\n      nextYear -= 1;\n    }\n    setActiveWeekId(`${nextYear}-W${String(week).padStart(2, \'0\')}`);\n  };\n\n  const weekMenu = household.menus[activeWeekId] || {\n    weekId: activeWeekId,\n    days: {} as any,\n  };\n\n  const handleOpenAddModal = (\n    dayKey: DayKey,\n    mealType: MealType,\n    target: \'together\' | \'daniele\' | \'partner\'\n  ) => {\n    const detail = dayDetails[dayKey];\n    const fullDayLabel = detail\n      ? `${DAY_NAMES[dayKey]} ${detail.formattedDate}`\n      : DAY_NAMES[dayKey];\n\n    setModalState({\n      isOpen: true,\n      dayKey,\n      dayLabel: fullDayLabel,\n      mealType,\n      target,\n    });\n  };\n\n  const handleAddDish = (\n    dishName: string,\n    target: \'together\' | \'daniele\' | \'partner\',\n    recipe?: Recipe,\n    addIngredients?: boolean\n  ) => {\n    if (!modalState) return;\n    const newDish: Dish = {\n      id: `dish_${Date.now()}_${Math.random().toString(36).substring(2, 5)}`,\n      name: dishName,\n      recipeId: recipe?.id,\n      ingredients: recipe?.ingredients || [],\n    };\n\n    addDishToSlot(\n      activeWeekId,\n      modalState.dayKey,\n      modalState.mealType,\n      target,\n      newDish,\n      addIngredients ?? true\n    );\n  };\n\n  return (\n    <div className=\"space-y-6 pb-20\">\n      {/* Week Selector Bar - Natural Calendar Dates View */}\n      <div className=\"bg-app-card rounded-2xl border border-app-subtle p-3 sm:p-4 shadow-xs flex flex-wrap items-center justify-between gap-3\">\n        <div className=\"flex items-center gap-2\">\n          {/* Previous week arrow */}\n          <button\n            onClick={() => changeWeek(-1)}\n            className=\"p-2 rounded-xl border border-app-subtle hover:bg-app-muted transition-colors cursor-pointer text-app-main active:scale-95\"\n            title=\"Settimana precedente\"\n          >\n            <ChevronLeft className=\"w-4 h-4\" />\n          </button>\n\n          {/* Interactive Calendar Date Trigger Button */}\n          <button\n            onClick={() => setIsCalendarOpen(true)}\n            className=\"flex items-center gap-2.5 px-3.5 py-1.5 bg-app-muted hover:bg-app-primary-light/70 hover:border-app-primary-border border border-transparent rounded-xl transition-all cursor-pointer group text-left\"\n            title=\"Apri il calendario mensile per scegliere settimana o data\"\n          >\n            <CalendarIcon className=\"w-4 h-4 text-app-primary group-hover:scale-110 transition-transform\" />\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"font-bold text-sm text-app-main group-hover:text-app-primary transition-colors\">\n                  {weekRange.label}\n                </span>\n                {weekRange.isCurrent && (\n                  <span className=\"text-[10px] font-bold px-1.5 py-0.5 rounded-md bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300\">\n                    Oggi\n                  </span>\n                )}\n              </div>\n              <span className=\"text-[10px] text-app-muted block leading-none mt-0.5\">\n                Tocca per aprire il calendario\n              </span>\n            </div>\n          </button>\n\n          {/* Next week arrow */}\n          <button\n            onClick={() => changeWeek(1)}\n            className=\"p-2 rounded-xl border border-app-subtle hover:bg-app-muted transition-colors cursor-pointer text-app-main active:scale-95\"\n            title=\"Settimana successiva\"\n          >\n            <ChevronRight className=\"w-4 h-4\" />\n          </button>\n\n          {/* Shortcut to current week if viewing other weeks */}\n          {!weekRange.isCurrent && (\n            <button\n              onClick={() => setActiveWeekId(currentRealWeek)}\n              className=\"text-xs font-semibold px-2.5 py-1.5 rounded-xl text-app-primary hover:bg-app-primary-light transition-colors cursor-pointer\"\n            >\n              Torna a oggi\n            </button>\n          )}\n        </div>\n\n        {/* Suggestion AI button */}\n        <button\n          onClick={onOpenAISuggest}\n          className=\"flex items-center gap-2 px-3.5 py-2 text-xs font-semibold rounded-xl bg-app-primary text-white hover:opacity-90 transition-opacity active:scale-95 shadow-xs cursor-pointer\"\n        >\n          <Sparkles className=\"w-3.5 h-3.5\" />\n          <span>Consigliami piatti di stagione</span>\n        </button>\n      </div>\n\n      {/* Week Schedule Grid */}\n      <div className=\"space-y-4\">\n        {DAY_KEYS.map((dayKey) => {\n          const detail = dayDetails[dayKey];\n          const isToday = detail?.isToday;\n\n          const dayMeals = weekMenu.days?.[dayKey] || {\n            dayKey,\n            dayLabel: DAY_NAMES[dayKey],\n            pranzo: { type: \'together\', togetherDishes: [], danieleDishes: [], partnerDishes: [] },\n            cena: { type: \'together\', togetherDishes: [], danieleDishes: [], partnerDishes: [] },\n          };\n\n          return (\n            <div\n              key={dayKey}\n              className={`bg-app-card rounded-2xl border shadow-xs overflow-hidden transition-all ${\n                isToday\n                  ? \'border-app-primary ring-2 ring-app-primary/20 shadow-sm\'\n                  : \'border-app-subtle hover:border-app-primary-border/60\'\n              }`}\n            >\n              {/* Day Header with actual localized date */}\n              <div\n                className={`px-4 py-2.5 border-b border-app-subtle flex items-center justify-between ${\n                  isToday\n                    ? \'bg-app-primary-light/60 dark:bg-app-primary-light/30\'\n                    : \'bg-app-muted/50\'\n                }`}\n              >\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"font-bold text-sm tracking-tight text-app-main\">\n                    {DAY_NAMES[dayKey]} {detail?.formattedDate}\n                  </span>\n                  {isToday && (\n                    <span className=\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-app-primary text-white\">\n                      Oggi\n                    </span>\n                  )}\n                </div>\n                <span className=\"text-[11px] text-app-muted font-medium\">\n                  Pranzo & Cena\n                </span>\n              </div>\n\n              {/* Day Meals Container */}\n              <div className=\"p-3 sm:p-4 grid grid-cols-1 md:grid-cols-2 gap-4\">\n                {/* PRANZO */}\n                <MealSlotCard\n                  title=\"Pranzo\"\n                  mealType=\"pranzo\"\n                  slot={dayMeals.pranzo}\n                  dayKey={dayKey}\n                  onToggleType={() => toggleMealSlotType(activeWeekId, dayKey, \'pranzo\')}\n                  onOpenAdd={(target) => handleOpenAddModal(dayKey, \'pranzo\', target)}\n                  onRemoveDish={(target, dishId) =>\n                    removeDishFromSlot(activeWeekId, dayKey, \'pranzo\', target, dishId)\n                  }\n                  currentRole={currentRole}\n                />\n\n                {/* CENA */}\n                <MealSlotCard\n                  title=\"Cena\"\n                  mealType=\"cena\"\n                  slot={dayMeals.cena}\n                  dayKey={dayKey}\n                  onToggleType={() => toggleMealSlotType(activeWeekId, dayKey, \'cena\')}\n                  onOpenAdd={(target) => handleOpenAddModal(dayKey, \'cena\', target)}\n                  onRemoveDish={(target, dishId) =>\n                    removeDishFromSlot(activeWeekId, dayKey, \'cena\', target, dishId)\n                  }\n                  currentRole={currentRole}\n                />\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Interactive Calendar Picker Modal */}\n      <CalendarPickerModal\n        isOpen={isCalendarOpen}\n        onClose={() => setIsCalendarOpen(false)}\n        selectedWeekId={activeWeekId}\n        onSelectWeek={(newWeekId) => setActiveWeekId(newWeekId)}\n      />\n\n      {/* Add Dish Modal */}\n      {modalState && (\n        <AddDishModal\n          isOpen={modalState.isOpen}\n          onClose={() => setModalState(null)}\n          dayKey={modalState.dayKey}\n          dayLabel={modalState.dayLabel}\n          mealType={modalState.mealType}\n          defaultTarget={modalState.target}\n          onAdd={handleAddDish}\n        />\n      )}\n    </div>\n  );\n};\n\n// Subcomponent: Meal Slot Card\ninterface MealSlotCardProps {\n  title: string;\n  mealType: MealType;\n  slot: MealSlot;\n  dayKey: DayKey;\n  onToggleType: () => void;\n  onOpenAdd: (target: \'together\' | \'daniele\' | \'partner\') => void;\n  onRemoveDish: (target: \'together\' | \'daniele\' | \'partner\', dishId: string) => void;\n  currentRole: \'daniele\' | \'partner\';\n}\n\nconst MealSlotCard: React.FC<MealSlotCardProps> = ({\n  title,\n  slot,\n  onToggleType,\n  onOpenAdd,\n  onRemoveDish,\n}) => {\n  const { household } = useHousehold();\n  const isTogether = slot.type === \'together\';\n\n  return (\n    <div className=\"rounded-xl border border-app-subtle bg-app-card p-3 flex flex-col justify-between\">\n      {/* Slot Header */}\n      <div className=\"flex items-center justify-between mb-2.5\">\n        <div className=\"flex items-center gap-1.5\">\n          <span className=\"text-xs font-bold text-app-main tracking-tight uppercase\">\n            {title}\n          </span>\n          <span className=\"text-[10px] text-app-muted\">\302\267</span>\n          <span className=\"text-[11px] font-medium text-app-muted\">\n            {isTogether ? \'Pasto Insieme\' : \'Pasti Separati\'}\n          </span>\n        </div>\n\n        {/* Toggle Mode Button */}\n        <button\n          onClick={onToggleType}\n          className={`px-2 py-1 text-[11px] font-semibold rounded-lg border transition-all cursor-pointer ${\n            isTogether\n              ? \'bg-app-primary-light text-app-primary border-app-primary-border hover:opacity-90\'\n              : \'bg-amber-50 text-amber-800 border-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:border-amber-900/50\'\n          }`}\n          title=\"Clicca per alternare tra pasto Insieme e pasti Separati\"\n        >\n          {isTogether ? \'\360\237\221\253 Insieme\' : \'\360\237\224\200 Separati\'}\n        </button>\n      </div>\n\n      {/* Dishes Area */}\n      {isTogether ? (\n        /* TOGETHER MODE */\n        <div className=\"space-y-2 flex-1\">\n          {slot.togetherDishes.length === 0 ? (\n            <div className=\"py-4 text-center border border-dashed border-app-subtle rounded-xl text-app-muted text-xs\">\n              Nessun piatto pianificato\n            </div>\n          ) : (\n            <div className=\"space-y-1.5\">\n              {slot.togetherDishes.map((dish) => (\n                <div\n                  key={dish.id}\n                  className=\"group flex items-center justify-between p-2 rounded-lg bg-app-muted/60 border border-app-subtle hover:border-app-primary-border transition-colors text-xs\"\n                >\n                  <div className=\"flex-1 mr-2\">\n                    <span className=\"font-semibold text-app-main block\">\n                      {dish.name}\n                    </span>\n                    {dish.ingredients && dish.ingredients.length > 0 && (\n                      <span className=\"text-[10px] text-app-muted line-clamp-1\">\n                        {dish.ingredients.join(\', \')}\n                      </span>\n                    )}\n                  </div>\n                  <button\n                    onClick={() => onRemoveDish(\'together\', dish.id)}\n                    className=\"opacity-60 hover:opacity-100 text-rose-500 p-1 rounded-md hover:bg-rose-50 dark:hover:bg-rose-950/30 transition-all cursor-pointer\"\n                    title=\"Rimuovi piatto\"\n                  >\n                    <Trash2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              ))}\n            </div>\n          )}\n\n          <button\n            onClick={() => onOpenAdd(\'together\')}\n            className=\"w-full mt-2 py-1.5 px-3 rounded-lg border border-dashed border-app-primary/40 text-app-primary hover:bg-app-primary-light transition-colors text-xs font-semibold flex items-center justify-center gap-1 cursor-pointer\"\n          >\n            <Plus className=\"w-3.5 h-3.5\" />\n            <span>Aggiungi piatto</span>\n          </button>\n        </div>\n      ) : (\n        /* SEPARATE MODE (DANIELE & PARTNER) */\n        <div className=\"grid grid-cols-2 gap-2 flex-1\">\n          {/* Column Daniele */}\n          <div className=\"p-2 rounded-xl bg-app-muted/40 border border-app-subtle flex flex-col justify-between\">\n            <div>\n              <div className=\"flex items-center gap-1 text-[11px] font-bold text-app-main mb-1.5 pb-1 border-b border-app-subtle\">\n                <span>{household.users.daniele.avatar}</span>\n                <span>{household.users.daniele.name}</span>\n              </div>\n\n              {slot.danieleDishes.length === 0 ? (\n                <div className=\"py-2 text-center text-[11px] text-app-muted italic\">\n                  Non pianificato\n                </div>\n              ) : (\n                <div className=\"space-y-1\">\n                  {slot.danieleDishes.map((dish) => (\n                    <div\n                      key={dish.id}\n                      className=\"flex items-start justify-between p-1.5 rounded-lg bg-app-card border border-app-subtle text-[11px]\"\n                    >\n                      <span className=\"font-medium text-app-main leading-tight mr-1\">\n                        {dish.name}\n                      </span>\n                      <button\n                        onClick={() => onRemoveDish(\'daniele\', dish.id)}\n                        className=\"text-rose-500 hover:text-rose-700 p-0.5 shrink-0 cursor-pointer\"\n                      >\n                        <Trash2 className=\"w-3 h-3\" />\n                      </button>\n                    </div>\n                  ))}\n                </div>\n              )}\n            </div>\n\n            <button\n              onClick={() => onOpenAdd(\'daniele\')}\n              className=\"mt-2 py-1 text-[10px] font-semibold text-app-primary hover:bg-app-primary-light rounded-md border border-dashed border-app-primary/30 flex items-center justify-center gap-1 cursor-pointer\"\n            >\n              <Plus className=\"w-3 h-3\" /> Piatto\n            </button>\n          </div>\n\n          {/* Column Partner */}\n          <div className=\"p-2 rounded-xl bg-app-muted/40 border border-app-subtle flex flex-col justify-between\">\n            <div>\n              <div className=\"flex items-center gap-1 text-[11px] font-bold text-app-main mb-1.5 pb-1 border-b border-app-subtle\">\n                <span>{household.users.partner.avatar}</span>\n                <span>{household.users.partner.name}</span>\n              </div>\n\n              {slot.partnerDishes.length === 0 ? (\n                <div className=\"py-2 text-center text-[11px] text-app-muted italic\">\n                  Non pianificato\n                </div>\n              ) : (\n                <div className=\"space-y-1\">\n                  {slot.partnerDishes.map((dish) => (\n                    <div\n                      key={dish.id}\n                      className=\"flex items-start justify-between p-1.5 rounded-lg bg-app-card border border-app-subtle text-[11px]\"\n                    >\n                      <span className=\"font-medium text-app-main leading-tight mr-1\">\n                        {dish.name}\n                      </span>\n                      <button\n                        onClick={() => onRemoveDish(\'partner\', dish.id)}\n                        className=\"text-rose-500 hover:text-rose-700 p-0.5 shrink-0 cursor-pointer\"\n                      >\n                        <Trash2 className=\"w-3 h-3\" />\n                      </button>\n                    </div>\n                  ))}\n                </div>\n              )}\n            </div>\n\n            <button\n              onClick={() => onOpenAdd(\'partner\')}\n              className=\"mt-2 py-1 text-[10px] font-semibold text-app-primary hover:bg-app-primary-light rounded-md border border-dashed border-app-primary/30 flex items-center justify-center gap-1 cursor-pointer\"\n            >\n              <Plus className=\"w-3 h-3\" /> Piatto\n            </button>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/WeeklyMenu/WeeklyMenuView.tsx"
        }
        overwrite: true
      }
    }
