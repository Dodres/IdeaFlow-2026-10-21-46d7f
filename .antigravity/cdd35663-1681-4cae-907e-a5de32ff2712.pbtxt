  code_action {
    action_spec {
      create_file {
        instruction: "import React, { createContext, useContext, useState, useEffect, useCallback, useMemo } from \'react\';\nimport {\n  Household,\n  ShoppingItem,\n  Recipe,\n  ColorTheme,\n  DisplayMode,\n  DayKey,\n  MealType,\n  MealSlot,\n  Dish,\n  MealSlotType,\n  Assignee,\n  SavedHouseholdInfo,\n  HouseDefinition,\n} from \'../types.ts\';\nimport { createInitialHousehold, getCurrentWeekId } from \'../data/initialData.ts\';\n\ninterface HouseholdContextValue {\n  household: Household;\n  householdCode: string;\n  savedHouseholds: SavedHouseholdInfo[];\n  isLoading: boolean;\n  isSyncing: boolean;\n  isConnected: boolean;\n  currentRole: \'daniele\' | \'partner\';\n  colorTheme: ColorTheme;\n  displayMode: DisplayMode;\n  activeWeekId: string;\n  setActiveWeekId: (weekId: string) => void;\n  setCurrentRole: (role: \'daniele\' | \'partner\') => void;\n  setColorTheme: (theme: ColorTheme) => void;\n  setDisplayMode: (mode: DisplayMode) => void;\n  setHouseholdCode: (code: string) => void;\n  joinHousehold: (code: string) => Promise<boolean>;\n  switchHousehold: (code: string) => Promise<boolean>;\n  removeSavedHousehold: (code: string) => void;\n  createNewHousehold: (name: string, customCode?: string, danieleName?: string, partnerName?: string) => Promise<string>;\n  updateHousehold: (updater: (prev: Household) => Household) => Promise<void>;\n  addHouseLocation: (name: string, icon?: string) => Promise<void>;\n  removeHouseLocation: (id: string) => Promise<void>;\n  setMealLocation: (weekId: string, dayKey: DayKey, mealType: MealType, location: string) => Promise<void>;\n  toggleShoppingItem: (itemId: string, isDone?: boolean) => Promise<void>;\n  addShoppingItem: (item: {\n    name: string;\n    category?: any;\n    assignee?: Assignee;\n    dishName?: string;\n    dayKey?: DayKey;\n    targetHouse?: string;\n  }) => Promise<void>;\n  addMultipleShoppingItems: (\n    items: Array<{\n      name: string;\n      category?: any;\n      assignee?: Assignee;\n      dishName?: string;\n      dayKey?: DayKey;\n      targetHouse?: string;\n    }>\n  ) => Promise<void>;\n  deleteShoppingItem: (itemId: string) => Promise<void>;\n  clearCompletedShopping: () => Promise<void>;\n  updateMealSlot: (weekId: string, dayKey: DayKey, mealType: MealType, slot: MealSlot) => Promise<void>;\n  addDishToSlot: (\n    weekId: string,\n    dayKey: DayKey,\n    mealType: MealType,\n    target: \'together\' | \'daniele\' | \'partner\',\n    dish: Dish,\n    autoAddIngredientsToShopping?: boolean\n  ) => Promise<void>;\n  removeDishFromSlot: (\n    weekId: string,\n    dayKey: DayKey,\n    mealType: MealType,\n    target: \'together\' | \'daniele\' | \'partner\',\n    dishId: string\n  ) => Promise<void>;\n  toggleMealSlotType: (weekId: string, dayKey: DayKey, mealType: MealType) => Promise<void>;\n  saveRecipe: (recipe: Recipe) => Promise<void>;\n  recordRecipePrepared: (recipeId: string, dateStr?: string) => Promise<void>;\n}\n\nconst HouseholdContext = createContext<HouseholdContextValue | null>(null);\n\nconst CODE_STORAGE_KEY = \'menu_spesa_household_code\';\nconst SAVED_HOUSES_KEY = \'menu_spesa_saved_households_list\';\nconst ROLE_STORAGE_KEY = \'menu_spesa_user_role\';\nconst THEME_STORAGE_KEY = \'menu_spesa_color_theme\';\nconst MODE_STORAGE_KEY = \'menu_spesa_display_mode\';\n\nexport const HouseholdProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {\n  const [householdCode, setHouseholdCodeState] = useState<string>(() => {\n    return localStorage.getItem(CODE_STORAGE_KEY) || \'CASA01\';\n  });\n\n  const [savedHouseholds, setSavedHouseholds] = useState<SavedHouseholdInfo[]>(() => {\n    try {\n      const stored = localStorage.getItem(SAVED_HOUSES_KEY);\n      if (stored) return JSON.parse(stored);\n    } catch {}\n    return [{ code: \'CASA01\', name: \'Casa Nostra\' }];\n  });\n\n  const [currentRole, setCurrentRoleState] = useState<\'daniele\' | \'partner\'>(() => {\n    return (localStorage.getItem(ROLE_STORAGE_KEY) as \'daniele\' | \'partner\') || \'daniele\';\n  });\n\n  const [colorTheme, setColorThemeState] = useState<ColorTheme>(() => {\n    return (localStorage.getItem(THEME_STORAGE_KEY) as ColorTheme) || \'salvia\';\n  });\n\n  const [displayMode, setDisplayModeState] = useState<DisplayMode>(() => {\n    return (localStorage.getItem(MODE_STORAGE_KEY) as DisplayMode) || \'auto\';\n  });\n\n  const [activeWeekId, setActiveWeekId] = useState<string>(getCurrentWeekId());\n  const [household, setHousehold] = useState<Household>(() => createInitialHousehold(householdCode));\n  const [isLoading, setIsLoading] = useState<boolean>(true);\n  const [isSyncing, setIsSyncing] = useState<boolean>(false);\n  const [isConnected, setIsConnected] = useState<boolean>(false);\n\n  // Apply theme to HTML tag\n  useEffect(() => {\n    const root = document.documentElement;\n    root.setAttribute(\'data-theme\', colorTheme);\n\n    const isDark =\n      displayMode === \'dark\' ||\n      (displayMode === \'auto\' && window.matchMedia(\'(prefers-color-scheme: dark)\').matches);\n\n    if (isDark) {\n      root.classList.add(\'dark\');\n    } else {\n      root.classList.remove(\'dark\');\n    }\n  }, [colorTheme, displayMode]);\n\n  // Handle system dark mode changes if mode === \'auto\'\n  useEffect(() => {\n    if (displayMode !== \'auto\') return;\n    const media = window.matchMedia(\'(prefers-color-scheme: dark)\');\n    const listener = (e: MediaQueryListEvent) => {\n      if (e.matches) {\n        document.documentElement.classList.add(\'dark\');\n      } else {\n        document.documentElement.classList.remove(\'dark\');\n      }\n    };\n    media.addEventListener(\'change\', listener);\n    return () => media.removeEventListener(\'change\', listener);\n  }, [displayMode]);\n\n  // Persist role, theme, mode\n  const setCurrentRole = (role: \'daniele\' | \'partner\') => {\n    setCurrentRoleState(role);\n    localStorage.setItem(ROLE_STORAGE_KEY, role);\n  };\n\n  const setColorTheme = (theme: ColorTheme) => {\n    setColorThemeState(theme);\n    localStorage.setItem(THEME_STORAGE_KEY, theme);\n  };\n\n  const setDisplayMode = (mode: DisplayMode) => {\n    setDisplayModeState(mode);\n    localStorage.setItem(MODE_STORAGE_KEY, mode);\n  };\n\n  const setHouseholdCode = (code: string) => {\n    const upper = code.trim().toUpperCase();\n    setHouseholdCodeState(upper);\n    localStorage.setItem(CODE_STORAGE_KEY, upper);\n  };\n\n  // Helper to add to saved households list\n  const registerSavedHousehold = (code: string, name: string) => {\n    setSavedHouseholds((prev) => {\n      const filtered = prev.filter((h) => h.code !== code);\n      const updated = [{ code, name }, ...filtered];\n      localStorage.setItem(SAVED_HOUSES_KEY, JSON.stringify(updated));\n      return updated;\n    });\n  };\n\n  const removeSavedHousehold = (code: string) => {\n    setSavedHouseholds((prev) => {\n      const updated = prev.filter((h) => h.code !== code);\n      localStorage.setItem(SAVED_HOUSES_KEY, JSON.stringify(updated));\n      return updated;\n    });\n  };\n\n  // Fetch initial household data\n  const fetchHousehold = useCallback(async (code: string) => {\n    try {\n      setIsLoading(true);\n      const res = await fetch(`/api/households/${code}`);\n      if (res.ok) {\n        const data = await res.json();\n        // Ensure default houses if missing\n        if (!data.houses || data.houses.length === 0) {\n          data.houses = [\n            { id: \'casa_daniele\', name: \'Casa Daniele\', icon: \'\360\237\217\240\' },\n            { id: \'casa_partner\', name: \'Casa Partner\', icon: \'\360\237\217\241\' },\n          ];\n        }\n        setHousehold(data);\n        registerSavedHousehold(data.code, data.name || data.code);\n      } else if (res.status === 404) {\n        console.warn(`Household ${code} not found, initializing...`);\n      }\n    } catch (err) {\n      console.error(\'Fetch household error:\', err);\n    } finally {\n      setIsLoading(false);\n    }\n  }, []);\n\n  useEffect(() => {\n    fetchHousehold(householdCode);\n  }, [householdCode, fetchHousehold]);\n\n  // Real-time SSE connection\n  useEffect(() => {\n    let eventSource: EventSource | null = null;\n    let reconnectTimeout: any = null;\n\n    const connectSSE = () => {\n      try {\n        eventSource = new EventSource(`/api/households/${householdCode}/events`);\n\n        eventSource.onopen = () => {\n          setIsConnected(true);\n        };\n\n        eventSource.addEventListener(\'update\', (e: MessageEvent) => {\n          try {\n            const payload = JSON.parse(e.data);\n            if (payload && payload.household) {\n              setHousehold(payload.household);\n              registerSavedHousehold(payload.household.code, payload.household.name);\n            }\n          } catch (err) {\n            console.error(\'SSE JSON error:\', err);\n          }\n        });\n\n        eventSource.onerror = () => {\n          setIsConnected(false);\n          eventSource?.close();\n          // Attempt reconnection after 3 seconds\n          reconnectTimeout = setTimeout(connectSSE, 3000);\n        };\n      } catch (err) {\n        setIsConnected(false);\n      }\n    };\n\n    connectSSE();\n\n    return () => {\n      if (eventSource) eventSource.close();\n      if (reconnectTimeout) clearTimeout(reconnectTimeout);\n    };\n  }, [householdCode]);\n\n  // Sync update helper\n  const saveHouseholdState = async (updated: Household) => {\n    setHousehold(updated);\n    setIsSyncing(true);\n    try {\n      await fetch(`/api/households/${householdCode}`, {\n        method: \'PUT\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify(updated),\n      });\n      registerSavedHousehold(updated.code, updated.name);\n    } catch (err) {\n      console.error(\'Failed to sync household:\', err);\n    } finally {\n      setIsSyncing(false);\n    }\n  };\n\n  const updateHousehold = async (updater: (prev: Household) => Household) => {\n    const next = updater(household);\n    await saveHouseholdState(next);\n  };\n\n  // Switch between saved households in 1 click\n  const switchHousehold = async (code: string): Promise<boolean> => {\n    const upper = code.trim().toUpperCase();\n    try {\n      setIsLoading(true);\n      const res = await fetch(`/api/households/${upper}`);\n      if (res.ok) {\n        const data = await res.json();\n        setHousehold(data);\n        setHouseholdCode(upper);\n        registerSavedHousehold(data.code, data.name);\n        return true;\n      }\n      return false;\n    } catch (err) {\n      return false;\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  // Join existing household\n  const joinHousehold = async (code: string): Promise<boolean> => {\n    return switchHousehold(code);\n  };\n\n  // Create new household\n  const createNewHousehold = async (\n    name: string,\n    customCode?: string,\n    danieleName?: string,\n    partnerName?: string\n  ): Promise<string> => {\n    try {\n      setIsLoading(true);\n      const res = await fetch(\'/api/households\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ name, customCode, danieleName, partnerName }),\n      });\n      if (res.ok) {\n        const data = await res.json();\n        setHousehold(data);\n        setHouseholdCode(data.code);\n        registerSavedHousehold(data.code, data.name);\n        return data.code;\n      }\n      throw new Error(\'Errore creazione spazio\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  // Manage Houses / Locations inside current household\n  const addHouseLocation = async (name: string, icon = \'\360\237\217\240\') => {\n    const newHouse: HouseDefinition = {\n      id: `house_${Date.now()}`,\n      name: name.trim(),\n      icon,\n    };\n    await updateHousehold((prev) => ({\n      ...prev,\n      houses: [...(prev.houses || []), newHouse],\n    }));\n  };\n\n  const removeHouseLocation = async (id: string) => {\n    await updateHousehold((prev) => ({\n      ...prev,\n      houses: (prev.houses || []).filter((h) => h.id !== id),\n    }));\n  };\n\n  const setMealLocation = async (\n    weekId: string,\n    dayKey: DayKey,\n    mealType: MealType,\n    location: string\n  ) => {\n    await updateHousehold((prev) => {\n      const weekMenu = prev.menus[weekId];\n      if (!weekMenu || !weekMenu.days[dayKey]) return prev;\n      const currentDay = weekMenu.days[dayKey];\n      const slot = currentDay[mealType];\n\n      return {\n        ...prev,\n        menus: {\n          ...prev.menus,\n          [weekId]: {\n            ...weekMenu,\n            days: {\n              ...weekMenu.days,\n              [dayKey]: {\n                ...currentDay,\n                [mealType]: {\n                  ...slot,\n                  location,\n                },\n              },\n            },\n          },\n        },\n      };\n    });\n  };\n\n  // Shopping List methods\n  const toggleShoppingItem = async (itemId: string, isDone?: boolean) => {\n    const currentItem = household.shoppingList.find((i) => i.id === itemId);\n    const newDoneState = typeof isDone === \'boolean\' ? isDone : !currentItem?.isDone;\n    const currentUserName = household.users[currentRole]?.name || (currentRole === \'daniele\' ? \'Daniele\' : \'Partner\');\n\n    // Optimistic update\n    setHousehold((prev) => ({\n      ...prev,\n      shoppingList: prev.shoppingList.map((it) =>\n        it.id === itemId\n          ? {\n              ...it,\n              isDone: newDoneState,\n              checkedBy: newDoneState ? currentUserName : undefined,\n              checkedAt: newDoneState ? new Date().toISOString() : undefined,\n            }\n          : it\n      ),\n    }));\n\n    try {\n      await fetch(`/api/households/${householdCode}/shopping/toggle`, {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ itemId, isDone: newDoneState, checkedBy: currentUserName }),\n      });\n    } catch (err) {\n      console.error(\'Toggle error:\', err);\n    }\n  };\n\n  const addShoppingItem = async (item: {\n    name: string;\n    category?: any;\n    assignee?: Assignee;\n    dishName?: string;\n    dayKey?: DayKey;\n    targetHouse?: string;\n  }) => {\n    let resolvedCategory = item.category;\n    if (!resolvedCategory) {\n      try {\n        const catRes = await fetch(\'/api/ai/categorize-product\', {\n          method: \'POST\',\n          headers: { \'Content-Type\': \'application/json\' },\n          body: JSON.stringify({ productName: item.name }),\n        });\n        const catData = await catRes.json();\n        resolvedCategory = catData.category || \'ortofrutta\';\n      } catch {\n        resolvedCategory = \'ortofrutta\';\n      }\n    }\n\n    const newItem: ShoppingItem = {\n      id: `sp_${Date.now()}_${Math.random().toString(36).substring(2, 6)}`,\n      name: item.name.trim(),\n      category: resolvedCategory,\n      assignee: item.assignee || \'together\',\n      dishName: item.dishName,\n      dayKey: item.dayKey,\n      targetHouse: item.targetHouse,\n      isDone: false,\n      createdAt: new Date().toISOString(),\n    };\n\n    setHousehold((prev) => ({\n      ...prev,\n      shoppingList: [newItem, ...prev.shoppingList],\n    }));\n\n    try {\n      await fetch(`/api/households/${householdCode}/shopping/add`, {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ items: [newItem] }),\n      });\n    } catch (err) {\n      console.error(\'Add item error:\', err);\n    }\n  };\n\n  const addMultipleShoppingItems = async (\n    items: Array<{\n      name: string;\n      category?: any;\n      assignee?: Assignee;\n      dishName?: string;\n      dayKey?: DayKey;\n      targetHouse?: string;\n    }>\n  ) => {\n    const formatted: ShoppingItem[] = items.map((it) => ({\n      id: `sp_${Date.now()}_${Math.random().toString(36).substring(2, 6)}`,\n      name: it.name.trim(),\n      category: it.category || \'ortofrutta\',\n      assignee: it.assignee || \'together\',\n      dishName: it.dishName,\n      dayKey: it.dayKey,\n      targetHouse: it.targetHouse,\n      isDone: false,\n      createdAt: new Date().toISOString(),\n    }));\n\n    setHousehold((prev) => ({\n      ...prev,\n      shoppingList: [...formatted, ...prev.shoppingList],\n    }));\n\n    try {\n      await fetch(`/api/households/${householdCode}/shopping/add`, {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ items: formatted }),\n      });\n    } catch (err) {\n      console.error(\'Add multiple items error:\', err);\n    }\n  };\n\n  const deleteShoppingItem = async (itemId: string) => {\n    setHousehold((prev) => ({\n      ...prev,\n      shoppingList: prev.shoppingList.filter((it) => it.id !== itemId),\n    }));\n\n    try {\n      await fetch(`/api/households/${householdCode}/shopping/${itemId}`, {\n        method: \'DELETE\',\n      });\n    } catch (err) {\n      console.error(\'Delete item error:\', err);\n    }\n  };\n\n  const clearCompletedShopping = async () => {\n    setHousehold((prev) => ({\n      ...prev,\n      shoppingList: prev.shoppingList.filter((it) => !it.isDone),\n    }));\n\n    try {\n      await fetch(`/api/households/${householdCode}/shopping/clear-completed`, {\n        method: \'POST\',\n      });\n    } catch (err) {\n      console.error(\'Clear completed error:\', err);\n    }\n  };\n\n  // Week Menu methods\n  const updateMealSlot = async (weekId: string, dayKey: DayKey, mealType: MealType, slot: MealSlot) => {\n    await updateHousehold((prev) => {\n      const currentWeekMenu = prev.menus[weekId] || {\n        weekId,\n        days: {} as any,\n      };\n\n      const currentDay = currentWeekMenu.days[dayKey] || {\n        dayKey,\n        dayLabel: dayKey,\n        pranzo: { type: \'together\', togetherDishes: [], danieleDishes: [], partnerDishes: [] },\n        cena: { type: \'together\', togetherDishes: [], danieleDishes: [], partnerDishes: [] },\n      };\n\n      const updatedDay = {\n        ...currentDay,\n        [mealType]: slot,\n      };\n\n      return {\n        ...prev,\n        menus: {\n          ...prev.menus,\n          [weekId]: {\n            ...currentWeekMenu,\n            days: {\n              ...currentWeekMenu.days,\n              [dayKey]: updatedDay,\n            },\n          },\n        },\n      };\n    });\n  };\n\n  const toggleMealSlotType = async (weekId: string, dayKey: DayKey, mealType: MealType) => {\n    const weekMenu = household.menus[weekId];\n    if (!weekMenu || !weekMenu.days[dayKey]) return;\n    const currentSlot = weekMenu.days[dayKey][mealType];\n    const newType: MealSlotType = currentSlot.type === \'together\' ? \'separate\' : \'together\';\n\n    const updatedSlot: MealSlot = {\n      ...currentSlot,\n      type: newType,\n    };\n\n    await updateMealSlot(weekId, dayKey, mealType, updatedSlot);\n  };\n\n  const addDishToSlot = async (\n    weekId: string,\n    dayKey: DayKey,\n    mealType: MealType,\n    target: \'together\' | \'daniele\' | \'partner\',\n    dish: Dish,\n    autoAddIngredientsToShopping = true\n  ) => {\n    await updateHousehold((prev) => {\n      const weekMenu = prev.menus[weekId];\n      if (!weekMenu || !weekMenu.days[dayKey]) return prev;\n      const currentDay = weekMenu.days[dayKey];\n      const slot = currentDay[mealType];\n\n      const updatedSlot: MealSlot = { ...slot };\n      if (target === \'together\') {\n        updatedSlot.togetherDishes = [...updatedSlot.togetherDishes, dish];\n      } else if (target === \'daniele\') {\n        updatedSlot.danieleDishes = [...updatedSlot.danieleDishes, dish];\n      } else {\n        updatedSlot.partnerDishes = [...updatedSlot.partnerDishes, dish];\n      }\n\n      return {\n        ...prev,\n        menus: {\n          ...prev.menus,\n          [weekId]: {\n            ...weekMenu,\n            days: {\n              ...weekMenu.days,\n              [dayKey]: {\n                ...currentDay,\n                [mealType]: updatedSlot,\n              },\n            },\n          },\n        },\n      };\n    });\n\n    if (autoAddIngredientsToShopping && dish.ingredients && dish.ingredients.length > 0) {\n      const assignee: Assignee = target === \'together\' ? \'together\' : target === \'daniele\' ? \'daniele\' : \'partner\';\n      const itemsToAdd = dish.ingredients.map((ing) => ({\n        name: ing,\n        assignee,\n        dishName: dish.name,\n        dayKey,\n      }));\n      await addMultipleShoppingItems(itemsToAdd);\n    }\n  };\n\n  const removeDishFromSlot = async (\n    weekId: string,\n    dayKey: DayKey,\n    mealType: MealType,\n    target: \'together\' | \'daniele\' | \'partner\',\n    dishId: string\n  ) => {\n    await updateHousehold((prev) => {\n      const weekMenu = prev.menus[weekId];\n      if (!weekMenu || !weekMenu.days[dayKey]) return prev;\n      const currentDay = weekMenu.days[dayKey];\n      const slot = currentDay[mealType];\n\n      const updatedSlot: MealSlot = { ...slot };\n      if (target === \'together\') {\n        updatedSlot.togetherDishes = updatedSlot.togetherDishes.filter((d) => d.id !== dishId);\n      } else if (target === \'daniele\') {\n        updatedSlot.danieleDishes = updatedSlot.danieleDishes.filter((d) => d.id !== dishId);\n      } else {\n        updatedSlot.partnerDishes = updatedSlot.partnerDishes.filter((d) => d.id !== dishId);\n      }\n\n      return {\n        ...prev,\n        menus: {\n          ...prev.menus,\n          [weekId]: {\n            ...weekMenu,\n            days: {\n              ...weekMenu.days,\n              [dayKey]: {\n                ...currentDay,\n                [mealType]: updatedSlot,\n              },\n            },\n          },\n        },\n      };\n    });\n  };\n\n  // Recipe methods\n  const saveRecipe = async (recipe: Recipe) => {\n    try {\n      const res = await fetch(`/api/households/${householdCode}/recipes`, {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify(recipe),\n      });\n      if (res.ok) {\n        const data = await res.json();\n        setHousehold((prev) => ({ ...prev, recipes: data.recipes }));\n      }\n    } catch (err) {\n      console.error(\'Save recipe error:\', err);\n    }\n  };\n\n  const recordRecipePrepared = async (recipeId: string, dateStr = new Date().toISOString().split(\'T\')[0]) => {\n    await updateHousehold((prev) => ({\n      ...prev,\n      recipes: prev.recipes.map((r) => (r.id === recipeId ? { ...r, lastPreparedDate: dateStr } : r)),\n    }));\n  };\n\n  const value = useMemo(\n    () => ({\n      household,\n      householdCode,\n      savedHouseholds,\n      isLoading,\n      isSyncing,\n      isConnected,\n      currentRole,\n      colorTheme,\n      displayMode,\n      activeWeekId,\n      setActiveWeekId,\n      setCurrentRole,\n      setColorTheme,\n      setDisplayMode,\n      setHouseholdCode,\n      joinHousehold,\n      switchHousehold,\n      removeSavedHousehold,\n      createNewHousehold,\n      updateHousehold,\n      addHouseLocation,\n      removeHouseLocation,\n      setMealLocation,\n      toggleShoppingItem,\n      addShoppingItem,\n      addMultipleShoppingItems,\n      deleteShoppingItem,\n      clearCompletedShopping,\n      updateMealSlot,\n      addDishToSlot,\n      removeDishFromSlot,\n      toggleMealSlotType,\n      saveRecipe,\n      recordRecipePrepared,\n    }),\n    [\n      household,\n      householdCode,\n      savedHouseholds,\n      isLoading,\n      isSyncing,\n      isConnected,\n      currentRole,\n      colorTheme,\n      displayMode,\n      activeWeekId,\n    ]\n  );\n\n  return <HouseholdContext.Provider value={value}>{children}</HouseholdContext.Provider>;\n};\n\nexport const useHousehold = () => {\n  const context = useContext(HouseholdContext);\n  if (!context) {\n    throw new Error(\'useHousehold must be used within a HouseholdProvider\');\n  }\n  return context;\n};\n"
