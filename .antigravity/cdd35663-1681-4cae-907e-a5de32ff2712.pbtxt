    end_line: 89
    content: "export type Season = \'spring\' | \'summer\' | \'autumn\' | \'winter\' | \'all_year\';\n\nexport type DepartmentCategory =\n  | \'ortofrutta\'\n  | \'macelleria_pescheria\'\n  | \'latticini_freschi\'\n  | \'dispensa_secco\'\n  | \'surgelati\'\n  | \'cura_casa_altro\';\n\nexport type Assignee = \'together\' | \'daniele\' | \'partner\';\n\nexport type MealSlotType = \'together\' | \'separate\';\n\nexport type MealType = \'pranzo\' | \'cena\';\n\nexport type DayKey = \'lun\' | \'mar\' | \'mer\' | \'gio\' | \'ven\' | \'sab\' | \'dom\';\n\nexport interface Dish {\n  id: string;\n  name: string;\n  recipeId?: string;\n  ingredients?: string[];\n  notes?: string;\n}\n\nexport interface MealSlot {\n  type: MealSlotType;\n  togetherDishes: Dish[];\n  danieleDishes: Dish[];\n  partnerDishes: Dish[];\n  notes?: string;\n}\n\nexport interface DayMeals {\n  dayKey: DayKey;\n  dayLabel: string;\n  pranzo: MealSlot;\n  cena: MealSlot;\n}\n\nexport interface WeekMenu {\n  weekId: string; // e.g. \'2026-W42\'\n  days: Record<DayKey, DayMeals>;\n}\n\nexport interface ShoppingItem {\n  id: string;\n  name: string;\n  category: DepartmentCategory;\n  assignee: Assignee;\n  dishName?: string;\n  dayKey?: DayKey;\n  isDone: boolean;\n  checkedBy?: string;\n  checkedAt?: string;\n  createdAt: string;\n}\n\nexport interface Recipe {\n  id: string;\n  name: string;\n  season: Season;\n  category: \'Primo\' | \'Secondo\' | \'Piatto Unico\' | \'Contorno\' | \'Lievitato\';\n  prepTime: string;\n  ingredients: string[];\n  notes?: string;\n  lastPreparedDate?: string; // YYYY-MM-DD\n}\n\nexport type ColorTheme = \'salvia\' | \'terracotta\' | \'mirtillo\' | \'avocado\' | \'slate\';\nexport type DisplayMode = \'light\' | \'dark\' | \'auto\';\n\nexport interface UserPreferences {\n  currentRole: \'daniele\' | \'partner\';\n  colorTheme: ColorTheme;\n  mode: DisplayMode;\n}\n\nexport interface HouseholdUsers {\n  daniele: { name: string; avatar: string };\n  partner: { name: string; avatar: string };\n}\n\nexport interface Household {\n  code: string;\n  name: string;\n  users: HouseholdUsers;\n  activeWeekId: string;\n  menus: Record<string, WeekMenu>;"
    num_lines: 105
    num_bytes: 2309
