    content: "  onToggleType: () => void;\n  onOpenAdd: (target: \'together\' | \'daniele\' | \'partner\') => void;\n  onRemoveDish: (target: \'together\' | \'daniele\' | \'partner\', dishId: string) => void;\n  currentRole: \'daniele\' | \'partner\';\n}\n\nconst MealSlotCard: React.FC<MealSlotCardProps> = ({\n  title,\n  slot,\n  onToggleType,\n  onOpenAdd,\n  onRemoveDish,\n}) => {\n  const { household } = useHousehold();\n  const isTogether = slot.type === \'together\';\n\n  return (\n    <div className=\"rounded-xl border border-app-subtle bg-app-card p-3 flex flex-col justify-between\">\n      {/* Slot Header */}\n      <div className=\"flex items-center justify-between mb-2.5\">\n        <div className=\"flex items-center gap-1.5\">\n          <span className=\"text-xs font-bold text-app-main tracking-tight uppercase\">\n            {title}\n          </span>\n          <span className=\"text-[10px] text-app-muted\">\302\267</span>\n          <span className=\"text-[11px] font-medium text-app-muted\">\n            {isTogether ? \'Pasto Insieme\' : \'Pasti Separati\'}\n          </span>\n        </div>\n\n        {/* Toggle Mode Button */}\n        <button\n          onClick={onToggleType}\n          className={`px-2 py-1 text-[11px] font-semibold rounded-lg border transition-all cursor-pointer ${\n            isTogether\n              ? \'bg-app-primary-light text-app-primary border-app-primary-border hover:opacity-90\'\n              : \'bg-amber-50 text-amber-800 border-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:border-amber-900/50\'\n          }`}\n          title=\"Clicca per alternare tra pasto Insieme e pasti Separati\"\n        >\n          {isTogether ? \'\360\237\221\253 Insieme\' : \'\360\237\224\200 Separati\'}\n        </button>\n      </div>\n\n      {/* Dishes Area */}\n      {isTogether ? (\n        /* TOGETHER MODE */\n        <div className=\"space-y-2 flex-1\">\n          {slot.togetherDishes.length === 0 ? (\n            <div className=\"py-4 text-center border border-dashed border-app-subtle rounded-xl text-app-muted text-xs\">\n              Nessun piatto pianificato\n            </div>\n          ) : (\n            <div className=\"space-y-1.5\">\n              {slot.togetherDishes.map((dish) => (\n                <div\n                  key={dish.id}\n                  className=\"group flex items-center justify-between p-2 rounded-lg bg-app-muted/60 border border-app-subtle hover:border-app-primary-border transition-colors text-xs\"\n                >\n                  <div className=\"flex-1 mr-2\">\n                    <span className=\"font-semibold text-app-main block\">"
