    content: "import React, { useState, useMemo } from \'react\';\nimport {\n  Check,\n  Plus,\n  Trash2,\n  Filter,\n  CheckCircle2,\n  Layers,\n  Calendar,\n  Utensils,\n  Tag,\n  Sparkles,\n  ShoppingBag,\n  RotateCcw,\n} from \'lucide-react\';\nimport { useHousehold } from \'../../context/HouseholdContext.tsx\';\nimport { ShoppingItem, DepartmentCategory, Assignee, DayKey } from \'../../types.ts\';\nimport { DEPARTMENT_LABELS } from \'../../data/initialData.ts\';\n\ntype GroupMode = \'reparto\' | \'ricetta\' | \'giorno\';\ntype FilterAssignee = \'all\' | \'together\' | \'mine\' | \'partner\';\n\nconst DAY_ORDER: Record<string, number> = {\n  lun: 1,\n  mar: 2,\n  mer: 3,\n  gio: 4,\n  ven: 5,\n  sab: 6,\n  dom: 7,\n};\n\nconst DAY_NAMES: Record<string, string> = {\n  lun: \'Luned\303\254\',\n  mar: \'Marted\303\254\',\n  mer: \'Mercoled\303\254\',\n  gio: \'Gioved\303\254\',\n  ven: \'Venerd\303\254\',\n  sab: \'Sabato\',\n  dom: \'Domenica\',\n};\n\nexport const ShoppingListView: React.FC = () => {\n  const {\n    household,\n    toggleShoppingItem,\n    addShoppingItem,\n    deleteShoppingItem,\n    clearCompletedShopping,\n    currentRole,\n  } = useHousehold();\n\n  // Controls state\n  const [groupMode, setGroupMode] = useState<GroupMode>(\'reparto\');\n  const [filterAssignee, setFilterAssignee] = useState<FilterAssignee>(\'all\');\n  const [quickInput, setQuickInput] = useState(\'\');\n  const [quickAssignee, setQuickAssignee] = useState<Assignee>(\'together\');\n  const [isAdding, setIsAdding] = useState(false);\n\n  const danieleName = household.users.daniele.name;\n  const partnerName = household.users.partner.name;\n\n  // Filter items by assignee\n  const filteredItems = useMemo(() => {\n    return household.shoppingList.filter((item) => {\n      if (filterAssignee === \'all\') return true;\n      if (filterAssignee === \'together\') return item.assignee === \'together\';\n      if (filterAssignee === \'mine\') return item.assignee === currentRole;\n      if (filterAssignee === \'partner\') {\n        const otherRole = currentRole === \'daniele\' ? \'partner\' : \'daniele\';\n        return item.assignee === otherRole;\n      }\n      return true;\n    });\n  }, [household.shoppingList, filterAssignee, currentRole]);\n\n  // Counts\n  const totalCount = filteredItems.length;\n  const doneCount = filteredItems.filter((i) => i.isDone).length;\n  const pendingCount = totalCount - doneCount;\n\n  // Quick Add submit\n  const handleQuickAdd = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!quickInput.trim() || isAdding) return;\n    try {\n      setIsAdding(true);\n      await addShoppingItem({\n        name: quickInput.trim(),\n        assignee: quickAssignee,\n        dishName: \'Fuori lista\',\n      });\n      setQuickInput(\'\');\n    } finally {\n      setIsAdding(false);\n    }\n  };\n\n  // Assignee badge styling\n  const renderAssigneeBadge = (assignee: Assignee) => {"
