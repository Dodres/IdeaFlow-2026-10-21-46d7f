verrides */\n.dark {\n  --bg-main: #121614;\n  --bg-card: #1B211E;\n  --bg-muted: #242C28;\n  --text-main: #F0F4F1;\n  --text-muted: #9BA89F;\n  --border-subtle: #2C3731;\n}\n\n.dark[data-theme=\"salvia\"] {\n  --primary: #6B9A7A;\n  --primary-hover: #5A8568;\n  --primary-light: #1D2A22;\n  --primary-border: #2C4234;\n}\n\n.dark[data-theme=\"terracotta\"] {\n  --bg-main: #171210;\n  --bg-card: #231B18;\n  --bg-muted: #2E2420;\n  --text-main: #F9EFEB;\n  --text-muted: #B5A49D;\n  --border-subtle: #3A2E29;\n  --primary: #E07352;\n  --primary-hover: #C65E3E;\n  --primary-light: #2E1B15;\n  --primary-border: #4D2D23;\n}\n\n.dark[data-theme=\"mirtillo\"] {\n  --bg-main: #0E131A;\n  --bg-card: #151D28;\n  --bg-muted: #1E2938;\n  --text-main: #EDF3FA;\n  --text-muted: #8E9EAF;\n  --border-subtle: #253346;\n  --primary: #4A7BB5;\n  --primary-hover: #396396;\n  --primary-light: #152233;\n  --primary-border: #233956;\n}\n\n.dark[data-theme=\"avocado\"] {\n  --bg-main: #13160F;\n  --bg-card: #1D2117;\n  --bg-muted: #272C1E;\n  --text-main: #F4F7EB;\n  --text-muted: #A3AA94;\n  --border-subtle: #343B27;\n  --primary: #839D52;\n  --primary-hover: #6F8643;\n  --primary-light: #232B16;\n  --primary-border: #3A4625;\n}\n\n.dark[data-theme=\"slate\"] {\n  --bg-main: #0B0F17;\n  --bg-card: #151B26;\n  --bg-muted: #1E2636;\n  --text-main: #F8FAFC;\n  --text-muted: #94A3B8;\n  --border-subtle: #293548;\n  --primary: #64748B;\n  --primary-hover: #475569;\n  --primary-light: #1E293B;\n  --primary-border: #334155;\n}\n\nbody {\n  background-color: var(--bg-main);\n  color: var(--text-main);\n  min-height: 100vh;\n  margin: 0;\n  padding: 0;\n}\n\n/* Custom utility colors */\n.bg-app-main { background-color: var(--bg-main); }\n.bg-app-card { background-color: var(--bg-card); }\n.bg-app-muted { background-color: var(--bg-muted); }\n.bg-app-primary { background-color: var(--primary); }\n.bg-app-primary-light { background-color: var(--primary-light); }\n\n.text-app-main { color: var(--text-main); }\n.text-app-muted { color: var(--text-muted); }\n.text-app-primary { color: var(--primary); }\n\n.border-app-subtle { border-color: var(--border-subtle); }\n.border-app-primary { border-color: var(--primary); }\n.border-app-primary-border { border-color: var(--primary-border); }\n\n/* Focus styles */\nbutton:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible {\n  outline: 2px solid var(--primary);\n  outline-offset: 2px;\n}\n"
