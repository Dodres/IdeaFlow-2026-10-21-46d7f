rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (default deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && incoming().uid == request.auth.uid;
      allow update: if isOwner(userId) && incoming().uid == request.auth.uid;
      allow delete: if isOwner(userId);
    }

    // Households Collection
    match /households/{householdCode} {
      // Allow get for signed in users looking up by code/link
      allow get: if isSignedIn() && isValidId(householdCode);

      // Allow list queries only for houses owned by or containing this member
      allow list: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.memberUids is list && request.auth.uid in resource.data.memberUids)
      );

      // Create: caller must be owner
      allow create: if isSignedIn() && isValidId(householdCode) && incoming().ownerUid == request.auth.uid;

      // Update: caller must be owner or member or joining
      allow update: if isSignedIn() && isValidId(householdCode) && (
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.memberUids is list && request.auth.uid in resource.data.memberUids) ||
        (request.resource.data.memberUids is list && request.auth.uid in request.resource.data.memberUids)
      );

      // Delete: only owner can delete
      allow delete: if isSignedIn() && isValidId(householdCode) && resource.data.ownerUid == request.auth.uid;
    }
  }
}
